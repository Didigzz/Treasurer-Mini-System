{
  "name": "my-better-t-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "libsql": "0.5.29",
      "@trpc/server": "^11.19.0",
      "@trpc/client": "^11.19.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @my-better-t-app/db --",
    "db:studio": "turbo run db:studio -F @my-better-t-app/db --",
    "db:generate": "turbo run db:generate -F @my-better-t-app/db --",
    "db:migrate": "turbo run db:migrate -F @my-better-t-app/db --",
    "db:local": "turbo run db:local -F @my-better-t-app/db --",
    "env:generate": "varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@my-better-t-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
