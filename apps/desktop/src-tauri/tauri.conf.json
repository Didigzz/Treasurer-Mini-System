{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boarding House Treasurer",
  "version": "1.0.0",
  "identifier": "com.boardinghouse.treasurer",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Boarding House Treasurer",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "category": "Finance",
    "shortDescription": "Local treasurer for boarding houses",
    "longDescription": "Track bills, shares, payments, and change for a boarding house. All data stays on this computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/server"],
    "resources": {
      "binaries/native_modules/": "native_modules/"
    }
  }
}
