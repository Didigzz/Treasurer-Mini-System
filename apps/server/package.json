{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@my-better-t-app/api": "workspace:*",
    "@my-better-t-app/db": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "^4.13.7",
    "libsql": "catalog:",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@my-better-t-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
