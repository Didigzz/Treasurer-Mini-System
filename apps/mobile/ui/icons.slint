// Stroke icons drawn on a 24 x 24 grid. Kept as SVG path strings so they
// render identically on desktop and Android without bundling image assets.

import { Theme } from "theme.slint";

export global Icons {
    out property <string> chevron-left: "M15 5.5 L8.5 12 L15 18.5";
    out property <string> chevron-right: "M9 5.5 L15.5 12 L9 18.5";
    out property <string> chevron-down: "M6 9 L12 15 L18 9";
    out property <string> plus: "M12 5 L12 19 M5 12 L19 12";
    out property <string> close: "M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5";
    out property <string> check: "M5 12.5 L10 17.5 L19 7.5";
    out property <string> person: "M12 3.5 A4 4 0 1 1 11.99 3.5 Z M4.5 20.5 C5.4 16.8 8.4 14.6 12 14.6 C15.6 14.6 18.6 16.8 19.5 20.5";
    out property <string> people: "M9 4 A3.5 3.5 0 1 1 8.99 4 Z M2.5 19.5 C3.3 16.2 5.9 14.3 9 14.3 C12.1 14.3 14.7 16.2 15.5 19.5 M16 4.4 A3.2 3.2 0 0 1 16 10.6 M18 14.6 C20 15.3 21.2 17.1 21.6 19.5";
    out property <string> clock: "M12 3 A9 9 0 1 1 11.99 3 Z M12 7.5 L12 12 L15.2 14";
    out property <string> chart: "M4 20.5 H20 M6.5 17 V12 M10.5 17 V7 M14.5 17 V10 M18.5 17 V5";
    out property <string> sliders: "M4 7 H12.5 M16.5 7 H20 M14.5 4.8 V9.2 M4 17 H7.5 M11.5 17 H20 M9.5 14.8 V19.2";
    out property <string> receipt: "M6 3.5 H18 V20.5 L15 18.8 L12 20.5 L9 18.8 L6 20.5 Z M9 8.5 H15 M9 12.5 H15";
    out property <string> download: "M12 4 V15 M7.5 10.5 L12 15 L16.5 10.5 M5 19.5 H19";
    out property <string> upload: "M12 15 V4 M7.5 8.5 L12 4 L16.5 8.5 M5 19.5 H19";
    out property <string> archive: "M4 5 H20 V9 H4 Z M5.5 9 V19 H18.5 V9 M10 13 H14";
    out property <string> pencil: "M4.5 19.5 L5.3 15.7 L16 5 L19 8 L8.3 18.7 Z M13.8 7.2 L16.8 10.2";
    out property <string> undo: "M9 6.5 L5 10.5 L9 14.5 M5 10.5 H14.5 A4.5 4.5 0 0 1 14.5 19.5 H11";
    out property <string> alert: "M12 3 A9 9 0 1 1 11.99 3 Z M12 7.5 V12.8 M12 16.2 V16.4";
    out property <string> cash: "M3 6.5 H21 V17.5 H3 Z M12 9.5 A2.5 2.5 0 1 1 11.99 9.5 Z M6.5 9.5 V9.6 M17.5 14.4 V14.5";
    out property <string> ban: "M12 3 A9 9 0 1 1 11.99 3 Z M5.7 5.7 L18.3 18.3";
    out property <string> more: "M5.5 12 V12.1 M12 12 V12.1 M18.5 12 V12.1";
    out property <string> calendar: "M4 6 H20 V20 H4 Z M4 10 H20 M8 3.5 V7.5 M16 3.5 V7.5";
}

export component Icon {
    in property <string> path;
    in property <brush> color: Theme.text;
    in property <length> size: 20px;
    in property <length> stroke-width: 1.9px;

    // Fixed width, flexible height: inside a HorizontalLayout the icon fills
    // the row height and the glyph stays vertically centred.
    width: root.size;
    min-height: root.size;
    preferred-height: root.size;
    accessible-role: none;

    Path {
        width: root.size;
        height: root.size;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.path;
        stroke: root.color;
        stroke-width: root.stroke-width;
        stroke-line-cap: round;
        fill: transparent;
    }
}
