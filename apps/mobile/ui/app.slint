import { ScrollView } from "std-widgets.slint";
import { BillRow, BalanceRow, BoarderRow, ShareRow, PaymentRow, HistoryRow, TypeRow, PickRow, ShareSplitPreviewRow, CalendarDay, ManageRow } from "models.slint";
import { Theme, Tone, Icons, AppButton, ButtonKind, TextField, SelectField, Banner, Sheet, SheetOption, SectionHeader, StatusPill, CalendarSheet, OverpaymentDialog, DetailRow } from "components.slint";
import { Responsive, TopBar, PillNav, MenuItem, ListCard } from "layout.slint";
import { DashboardScreen } from "screens/dashboard.slint";
import { BoardersScreen } from "screens/boarders.slint";
import { HistoryScreen } from "screens/history.slint";
import { SettingsScreen } from "screens/settings.slint";
import { NewBillScreen } from "screens/new-bill.slint";
import { BillScreen } from "screens/bill.slint";
import { LedgerScreen } from "screens/ledger.slint";

export { BillRow, BalanceRow, BoarderRow, ShareRow, PaymentRow, HistoryRow, TypeRow, PickRow, ShareSplitPreviewRow, CalendarDay, ManageRow } from "models.slint";

// Bottom sheets owned by the window so they cover the navigation too.
enum SheetKind { none, pay, void-payment, edit-share, currency, bill-type, boarder-actions, rename, delete-boarder, delete-bill, restore, calendar, manage-shares, return-change, payment-detail }

// Screen ids (set from Rust): 0 Dashboard, 1 Boarders, 3 History, 4 Settings,
// 10 Bill, 11 Boarder ledger, 12 New bill.
export component AppWindow inherits Window {
    title: "Boarding House Treasurer";
    preferred-width: 420px;
    preferred-height: 860px;
    min-width: 320px;
    min-height: 480px;
    background: Theme.bg;
    default-font-size: Theme.text-body;

    in property <int> screen: 0;
    in property <string> screen-title: "Dashboard";
    in-out property <string> message: "";
    in-out property <bool> message-error: false;

    in-out property <string> period-label: "";
    in property <string> total-expected: "";
    in property <string> total-paid: "";
    in property <string> total-outstanding: "";
    in property <string> total-change: "";
    in property <float> total-progress: 0;
    in property <string> archived-note: "";
    in property <int> filter: 0;
    in-out property <bool> include-archived: false;

    in property <[BillRow]> bills: [];
    in property <[BalanceRow]> balances: [];
    in property <[BoarderRow]> boarders: [];
    in property <[ShareRow]> shares: [];
    in property <[PaymentRow]> payments: [];
    in property <[ShareSplitPreviewRow]> share-preview: [];
    in property <[HistoryRow]> history: [];
    in property <[TypeRow]> types: [];
    in property <[PickRow]> picks: [];
    in property <[CalendarDay]> calendar-days: [];
    in property <[ManageRow]> manage-rows: [];
    in property <[string]> month-names: [];
    in property <[string]> manage-candidates: [];

    in property <[string]> currency-names: [];
    in property <[string]> bill-type-names: [];
    in-out property <int> currency-index: 0;
    in-out property <bool> allow-centavos: true;
    in-out property <int> bill-type-index: 0;

    in-out property <string> new-boarder-name: "";
    in-out property <string> rename-name: "";
    in-out property <string> type-name: "";
    in-out property <string> bill-total: "";
    in-out property <string> bill-year: "";
    in-out property <string> bill-month: "";
    in-out property <string> bill-due: "";
    in-out property <string> bill-note: "";
    in-out property <string> payment-amount: "";
    in-out property <string> payment-date: "";
    in-out property <string> void-reason: "";

    // Calendar sheet (one picker for every date the treasurer enters).
    in property <int> calendar-target: 0;
    in property <string> calendar-title: "";
    in property <int> calendar-year: 2026;
    in property <int> calendar-month: 11;
    in property <string> calendar-header-label: "";
    in property <bool> calendar-month-only: false;
    in property <bool> calendar-allow-clear: false;
    in property <bool> calendar-include-time: false;
    in property <int> calendar-hour: 12;
    in property <int> calendar-minute: 0;
    in property <bool> calendar-pm: false;
    in property <string> calendar-time-label: "";

    in property <string> bill-due-label: "";
    in property <string> bill-period-label: "";
    in-out property <string> payment-date-label: "";
    in-out property <string> payment-time: "";
    in-out property <int> share-edit-target: -1;

    // Manage shares sheet.
    in property <string> manage-subtitle: "";

    // Return-change confirmation sheet.
    in property <string> return-change-subtitle: "";
    in property <string> return-change-amount: "";
    in property <string> return-change-date-label: "";
    in-out property <string> return-change-note: "";

    // Payment detail sheet.
    in property <string> pd-subtitle: "";
    in property <string> pd-total: "";
    in property <string> pd-received: "";
    in property <string> pd-change-returned: "";
    in property <string> pd-net: "";
    in property <string> pd-payment-status: "";
    in property <string> pd-change-status: "";
    in property <string> pd-recorded: "";
    in property <string> pd-returned-on: "";
    in property <bool> pd-voided: false;
    in property <string> pd-void-reason: "";
    in property <bool> pd-has-returned: false;
    in property <bool> pd-can-return: false;

    // Overpayment notice.
    in-out property <bool> overpay-shown: false;
    in property <string> overpay-subtitle: "";
    in property <string> overpay-amount: "";
    in property <string> overpay-change: "";
    in property <string> overpay-due: "";

    // Share filter and editor state (bill screen only).
    in-out property <string> share-filter: "";
    in-out property <int> share-filter-mode: 0;
    in property <int> share-total-count: 0;
    in property <int> share-visible-count: 0;
    in-out property <string> share-edit-amount: "";
    in-out property <string> share-edit-charge: "";
    in property <string> share-edit-name: "";
    in property <string> share-edit-error: "";
    in property <string> share-edit-footer: "";
    in property <bool> share-edit-locked: false;
    in property <bool> share-edit-archived: false;
    in property <bool> share-edit-can-save: false;

    in property <string> detail-title: "";
    in property <string> detail-subtitle: "";
    in property <string> detail-initials: "";
    in property <string> detail-status: "";
    in property <bool> detail-archived: false;
    in property <string> detail-expected: "";
    in property <string> detail-collected: "";
    in property <string> detail-outstanding: "";
    in property <string> detail-change: "";
    in property <float> detail-progress: 0;
    in property <string> detail-total: "";
    in property <string> last-backup: "";
    in property <string> app-version: "";

    callback nav(int);
    callback prev-month();
    callback next-month();
    callback set-filter(int);
    callback open-bill(int);
    callback open-boarder(int);
    callback open-ledger(int);
    callback open-history(int);
    callback back();
    callback add-boarder(string);
    callback rename-boarder(int, string);
    callback archive-boarder(int);
    callback delete-boarder(int);
    callback add-bill-type(string);
    callback archive-type(int);
    callback open-new-bill();
    callback pick-toggle(int);
    callback pick-amount(int, string);
    callback create-bill();
    callback pay-share(int);
    callback void-payment(int);
    callback return-change(int);
    callback archive-bill();
    callback delete-bill();
    callback set-share-filter(string);
    callback set-share-filter-mode(int);
    callback edit-share(int);
    callback preview-share-split(string, string);
    callback save-share();
    callback export-backup();
    callback import-backup();
    callback save-settings();
    callback toggle-archived();
    callback open-calendar(int);
    callback calendar-prev-month();
    callback calendar-next-month();
    callback calendar-pick(string);
    callback calendar-today();
    callback calendar-clear();
    callback calendar-confirm();
    callback calendar-time-changed(int, int, bool);
    callback calendar-pick-month(int);
    callback calendar-pick-year(int);
    callback overpay-dismiss();
    callback overpay-return-change();
    callback manage-shares();
    callback manage-edit(int);
    callback manage-exclude(int);
    callback manage-add(int);
    callback open-payment(int);
    callback return-share-change(int);
    callback return-change-confirm();
    callback return-change-pick-date();
    callback payment-detail-correct-date();
    callback payment-detail-return();

    // ---- Shell state ----
    property <SheetKind> sheet: SheetKind.none;
    property <int> sheet-index: -1;
    property <bool> menu-open: false;
    property <int> manage-pending: -1;
    // Set while the calendar is correcting a returned date from the detail sheet.
    property <bool> detail-correcting: false;

    property <bool> is-tab: root.screen == 0 || root.screen == 1 || root.screen == 3;
    property <int> tab-index: root.screen == 1 ? 1 : root.screen == 3 ? 2 : 0;
    property <length> safe-top: root.safe-area-insets.top;
    property <length> safe-bottom: root.safe-area-insets.bottom;
    // Height of the on-screen keyboard over the window (0 on desktop).
    property <length> keyboard: root.virtual-keyboard-size.height > 0
        ? max(0px, root.height - root.virtual-keyboard-position.y)
        : 0px;
    property <length> bottom-inset: max(root.safe-bottom, root.keyboard);
    property <bool> nav-shown: root.is-tab && root.keyboard == 0;
    property <length> nav-clearance: Theme.nav-height + 12px + root.safe-bottom + Theme.space-2;
    property <string> sheet-error: root.message-error ? root.message : "";
    // Same geometry as PillNav: capped pill + 12px gap + 56px "+" button.
    property <length> nav-pill-width: min(300px, root.width - 100px);
    property <length> fab-right: (root.width + root.nav-pill-width + 68px) / 2;

    init => { Responsive.width = self.width; }
    changed width => { Responsive.width = self.width; }
    changed screen => {
        // Close overlays only; Rust may have just reported an error for the
        // new screen, which must stay visible.
        root.menu-open = false;
        root.sheet = SheetKind.none;
        root.sheet-index = -1;
        keys.focus();
    }

    function open-sheet(kind: SheetKind, index: int) {
        root.menu-open = false;
        root.message = "";
        root.message-error = false;
        root.manage-pending = -1;
        root.sheet-index = index;
        root.sheet = kind;
    }

    function close-sheet() {
        // An error belongs to the sheet that produced it; don't leave it
        // behind on the page.
        if root.message-error {
            root.message = "";
            root.message-error = false;
        }
        root.sheet = SheetKind.none;
        root.sheet-index = -1;
        keys.focus();
    }

    // Runs before a sheet action so the result can be read back afterwards:
    // Rust reports failures through `message` with `message-error = true`.
    function begin-action() {
        root.message = "";
        root.message-error = false;
    }

    function clear-error() {
        root.message = "";
        root.message-error = false;
    }

    // Hardware Back (Android) / Escape (desktop). Returns false at the root of
    // the app so the system can handle it (e.g. leave the app).
    function go-back() -> bool {
        if root.overpay-shown {
            root.overpay-shown = false;
            return true;
        }
        if root.menu-open {
            root.menu-open = false;
            return true;
        }
        if root.sheet != SheetKind.none {
            root.close-sheet();
            return true;
        }
        if root.screen >= 10 || root.screen == 4 {
            root.back();
            return true;
        }
        if root.screen != 0 {
            root.nav(0);
            return true;
        }
        return false;
    }

    forward-focus: keys;

    keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Back {
                return root.go-back() ? EventResult.accept : EventResult.reject;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            padding-top: root.safe-top;

            TopBar {
                title: root.screen-title;
                large: root.is-tab;
                can-go-back: !root.is-tab;
                back => { root.back(); }
            }

            // While a sheet is open its own inline banner shows the message.
            if root.message != "" && root.sheet == SheetKind.none : HorizontalLayout {
                padding-left: Responsive.gutter;
                padding-right: Responsive.gutter;
                padding-bottom: Theme.space-2;
                Banner {
                    text: root.message;
                    error: root.message-error;
                    dismiss => { root.message = ""; }
                }
            }

            Rectangle {
                vertical-stretch: 1;

                if root.screen == 0 : DashboardScreen {
                    width: 100%;
                    height: 100%;
                    bottom-inset: root.nav-clearance;
                    period-label: root.period-label;
                    total-expected: root.total-expected;
                    total-paid: root.total-paid;
                    total-outstanding: root.total-outstanding;
                    total-change: root.total-change;
                    total-progress: root.total-progress;
                    archived-note: root.archived-note;
                    include-archived: root.include-archived;
                    filter: root.filter;
                    bills: root.bills;
                    balances: root.balances;
                    prev-month => { root.prev-month(); }
                    next-month => { root.next-month(); }
                    pick-period => { root.open-calendar(4); }
                    set-filter(i) => { root.set-filter(i); }
                    open-bill(i) => { root.open-bill(i); }
                    open-boarder(i) => { root.open-boarder(i); }
                    new-bill => { root.open-new-bill(); }
                    toggle-archived => { root.toggle-archived(); }
                }

                if root.screen == 1 : BoardersScreen {
                    width: 100%;
                    height: 100%;
                    bottom-inset: max(root.nav-clearance, root.keyboard);
                    boarders: root.boarders;
                    new-boarder-name <=> root.new-boarder-name;
                    add-boarder(name) => { root.add-boarder(name); }
                    open-ledger(i) => { root.open-ledger(i); }
                    show-actions(i) => { root.open-sheet(SheetKind.boarder-actions, i); }
                }

                if root.screen == 3 : HistoryScreen {
                    width: 100%;
                    height: 100%;
                    bottom-inset: root.nav-clearance;
                    history: root.history;
                    open-history(i) => { root.open-history(i); }
                }

                if root.screen == 4 : SettingsScreen {
                    width: 100%;
                    height: 100%;
                    bottom-inset: root.bottom-inset;
                    currency-label: root.currency-names.length > root.currency-index ? root.currency-names[root.currency-index] : "";
                    allow-centavos: root.allow-centavos;
                    last-backup: root.last-backup;
                    app-version: root.app-version;
                    types: root.types;
                    type-name <=> root.type-name;
                    pick-currency => { root.open-sheet(SheetKind.currency, -1); }
                    toggle-centavos => {
                        root.allow-centavos = !root.allow-centavos;
                        root.save-settings();
                    }
                    add-bill-type(name) => { root.add-bill-type(name); }
                    archive-type(i) => { root.archive-type(i); }
                    export-backup => { root.export-backup(); }
                    restore-backup => { root.open-sheet(SheetKind.restore, -1); }
                }

                if root.screen == 12 : NewBillScreen {
                    width: 100%;
                    height: 100%;
                    bottom-inset: root.bottom-inset;
                    bill-type-label: root.bill-type-names.length > root.bill-type-index ? root.bill-type-names[root.bill-type-index] : "";
                    has-bill-types: root.bill-type-names.length > 0;
                    picks: root.picks;
                    bill-period-label: root.bill-period-label;
                    bill-due-label: root.bill-due-label;
                    bill-total <=> root.bill-total;
                    bill-note <=> root.bill-note;
                    pick-type => { root.open-sheet(SheetKind.bill-type, -1); }
                    pick-period => { root.open-calendar(3); }
                    pick-due => { root.open-calendar(1); }
                    pick-toggle(i) => { root.pick-toggle(i); }
                    pick-amount(i, value) => { root.pick-amount(i, value); }
                    create-bill => { root.create-bill(); }
                    go-settings => { root.nav(4); }
                    go-boarders => { root.nav(1); }
                }

                if root.screen == 10 : BillScreen {
                    width: 100%;
                    height: 100%;
                    bottom-inset: root.bottom-inset;
                    detail-title: root.detail-title;
                    detail-subtitle: root.detail-subtitle;
                    detail-status: root.detail-status;
                    detail-archived: root.detail-archived;
                    detail-expected: root.detail-expected;
                    detail-collected: root.detail-collected;
                    detail-outstanding: root.detail-outstanding;
                    detail-change: root.detail-change;
                    detail-progress: root.detail-progress;
                    shares: root.shares;
                    payments: root.payments;
                    share-filter <=> root.share-filter;
                    share-filter-mode <=> root.share-filter-mode;
                    share-total-count: root.share-total-count;
                    share-visible-count: root.share-visible-count;
                    set-share-filter(value) => { root.set-share-filter(value); }
                    set-share-filter-mode(mode) => { root.set-share-filter-mode(mode); }
                    edit-share(i) => {
                        root.open-sheet(SheetKind.edit-share, i);
                        root.edit-share(i);
                    }
                    pay(i) => {
                        root.payment-amount = "";
                        root.payment-date = "";
                        root.payment-time = "";
                        root.payment-date-label = "";
                        root.open-sheet(SheetKind.pay, i);
                    }
                    void-payment(i) => {
                        root.void-reason = "";
                        root.open-sheet(SheetKind.void-payment, i);
                    }
                    return-change(i) => {
                        root.begin-action();
                        root.return-change(i);
                        if !root.message-error { root.open-sheet(SheetKind.return-change, -1); }
                    }
                    return-share-change(i) => {
                        root.begin-action();
                        root.return-share-change(i);
                        if !root.message-error { root.open-sheet(SheetKind.return-change, -1); }
                    }
                    manage-shares => {
                        root.begin-action();
                        root.manage-shares();
                        if !root.message-error { root.open-sheet(SheetKind.manage-shares, -1); }
                    }
                    open-payment(i) => {
                        root.begin-action();
                        root.open-payment(i);
                        if !root.message-error { root.open-sheet(SheetKind.payment-detail, -1); }
                    }
                    archive-bill => { root.archive-bill(); }
                    delete-bill => { root.open-sheet(SheetKind.delete-bill, -1); }
                }

                if root.screen == 11 : LedgerScreen {
                    width: 100%;
                    height: 100%;
                    bottom-inset: root.bottom-inset;
                    detail-title: root.detail-title;
                    detail-initials: root.detail-initials;
                    detail-expected: root.detail-expected;
                    detail-collected: root.detail-collected;
                    detail-outstanding: root.detail-outstanding;
                    detail-change: root.detail-change;
                    detail-progress: root.detail-progress;
                    shares: root.shares;
                    payments: root.payments;
                    open-bill(i) => { root.open-bill(i); }
                    open-payment(i) => {
                        root.begin-action();
                        root.open-payment(i);
                        if !root.message-error { root.open-sheet(SheetKind.payment-detail, -1); }
                    }
                }
            }
        }

        // ---- Floating navigation ----
        if root.is-tab : nav := PillNav {
            x: 0;
            width: parent.width;
            y: root.nav-shown ? parent.height - root.safe-bottom - 12px - self.height : parent.height + 24px;
            active: root.tab-index;
            menu-open: root.menu-open;
            select(i) => {
                root.menu-open = false;
                root.nav(i == 0 ? 0 : i == 1 ? 1 : 3);
            }
            toggle-menu => { root.menu-open = !root.menu-open; }

            animate y { duration: Theme.medium; easing: ease-out; }
        }

        // ---- "+" menu (no scrim; tapping outside closes it) ----
        if root.menu-open : TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.menu-open = false; }
        }
        if root.menu-open && root.is-tab : Rectangle {
            property <bool> shown: false;
            init => { self.shown = true; }

            width: 210px;
            height: menu-col.preferred-height;
            // Right-aligned with the "+" button (mirrors PillNav's geometry).
            x: max(Theme.space-2, root.fab-right - self.width);
            y: parent.height - root.safe-bottom - 12px - Theme.nav-height - 10px - self.height + (self.shown ? 0px : 8px);
            opacity: self.shown ? 1 : 0;
            background: Theme.chrome-raised;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.chrome-border;
            drop-shadow-blur: 20px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000066;
            accessible-role: list;
            accessible-label: "More actions";

            animate y, opacity { duration: Theme.fast; easing: ease-out; }

            TouchArea { }

            menu-col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                MenuItem {
                    text: "New bill";
                    icon: Icons.receipt;
                    clicked => {
                        root.menu-open = false;
                        root.open-new-bill();
                    }
                }
                MenuItem {
                    text: "Settings";
                    icon: Icons.sliders;
                    clicked => {
                        root.menu-open = false;
                        root.nav(4);
                    }
                }
            }
        }

        // ---- Sheets ----
        if root.sheet == SheetKind.pay && root.sheet-index >= 0 && root.sheet-index < root.shares.length : pay-sheet := Sheet {
            property <ShareRow> share: root.shares[root.sheet-index];
            title: "Record payment";
            subtitle: pay-sheet.share.name + " · " + (pay-sheet.share.has-balance ? pay-sheet.share.balance + " left to pay" : "fully paid");
            error: root.sheet-error;
            clear-error => { root.clear-error(); }
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            TextField {
                label: "Amount received";
                placeholder: "0.00";
                text <=> root.payment-amount;
            }
            if pay-sheet.share.has-balance : HorizontalLayout {
                alignment: start;
                AppButton {
                    text: "Use full balance (" + pay-sheet.share.balance + ")";
                    kind: ButtonKind.secondary;
                    compact: true;
                    clicked => { root.payment-amount = pay-sheet.share.balance-input; }
                }
            }
            SelectField {
                label: "Payment date";
                value: root.payment-date-label;
                placeholder: "Today";
                clicked => { root.open-calendar(2); }
            }
            AppButton {
                text: "Record payment";
                icon: Icons.check;
                enabled: root.payment-amount != "";
                clicked => {
                    root.begin-action();
                    root.pay-share(root.sheet-index);
                    if !root.message-error { root.close-sheet(); }
                }
            }
        }

        if root.sheet == SheetKind.edit-share : Sheet {
            title: "Edit share";
            subtitle: root.share-edit-name + " · Total " + root.detail-total;
            error: root.sheet-error;
            clear-error => { root.clear-error(); }
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            if root.share-edit-archived : Banner {
                text: "This bill is archived. Changes apply immediately and appear on the bill; they are kept if you restore it.";
                warning: true;
                dismissible: false;
            }

            if root.share-edit-error != "" : Banner {
                text: root.share-edit-error;
                error: true;
                dismissible: false;
            }

            TextField {
                label: "Share amount";
                placeholder: "0.00";
                input-type: InputType.number;
                enabled: !root.share-edit-locked;
                hint: root.share-edit-locked
                    ? "Share amounts are locked because payments have been recorded. Additional charges can still be changed."
                    : "";
                text <=> root.share-edit-amount;
                edited(value) => { root.preview-share-split(value, root.share-edit-charge); }
            }

            TextField {
                label: "Additional charge";
                placeholder: "0.00";
                input-type: InputType.number;
                hint: "Optional, added on top of this share. It is not part of the bill total.";
                text <=> root.share-edit-charge;
                edited(value) => { root.preview-share-split(root.share-edit-amount, value); }
            }

            VerticalLayout {
                spacing: Theme.space-2;
                SectionHeader { title: "Split preview"; }
                ScrollView {
                    height: min(root.share-preview.length * 44px + 2px, 184px);
                    VerticalLayout {
                        ListCard {
                            for row[i] in root.share-preview : Rectangle {
                                height: 44px;
                                background: row.pinned ? Theme.accent-soft : transparent;

                                if i > 0 : Rectangle {
                                    x: Theme.space-3;
                                    width: parent.width - Theme.space-3;
                                    height: 1px;
                                    background: Theme.divider;
                                }

                                HorizontalLayout {
                                    padding-left: Theme.space-3;
                                    padding-right: Theme.space-3;
                                    spacing: Theme.space-2;
                                    Text {
                                        text: row.name;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        font-size: Theme.text-sub;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    if row.pinned : StatusPill {
                                        text: "Edited";
                                        tone: Tone.accent;
                                    }
                                    Text {
                                        text: row.amount;
                                        vertical-alignment: center;
                                        font-size: Theme.text-sub;
                                        font-weight: Theme.weight-semibold;
                                        color: Theme.text;
                                    }
                                }
                            }
                        }
                    }
                }
                Text {
                    text: root.share-edit-footer;
                    font-size: Theme.text-caption;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            AppButton {
                text: "Save share";
                icon: Icons.check;
                enabled: root.share-edit-can-save;
                clicked => {
                    root.begin-action();
                    root.save-share();
                    if !root.message-error { root.close-sheet(); }
                }
            }
            AppButton {
                text: "Cancel";
                kind: ButtonKind.secondary;
                clicked => { root.close-sheet(); }
            }
        }

        if root.sheet == SheetKind.void-payment && root.sheet-index >= 0 && root.sheet-index < root.payments.length : Sheet {
            title: "Void this payment?";
            subtitle: root.payments[root.sheet-index].title + " · " + root.payments[root.sheet-index].amount;
            error: root.sheet-error;
            clear-error => { root.clear-error(); }
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            Text {
                text: "The payment stays in the history marked as voided and stops counting toward the balance. This can't be undone.";
                font-size: Theme.text-sub;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            TextField {
                label: "Reason";
                placeholder: "e.g. Recorded twice";
                text <=> root.void-reason;
            }
            AppButton {
                text: "Void payment";
                icon: Icons.ban;
                kind: ButtonKind.danger;
                enabled: root.void-reason != "";
                clicked => {
                    root.begin-action();
                    root.void-payment(root.sheet-index);
                    if !root.message-error { root.close-sheet(); }
                }
            }
            AppButton {
                text: "Keep payment";
                kind: ButtonKind.secondary;
                clicked => { root.close-sheet(); }
            }
        }

        if root.sheet == SheetKind.currency : Sheet {
            title: "Currency";
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            ScrollView {
                height: min(root.currency-names.length * 54px, root.height * 0.55);
                VerticalLayout {
                    spacing: 2px;
                    for name[i] in root.currency-names : SheetOption {
                        text: name;
                        selected: i == root.currency-index;
                        clicked => {
                            root.close-sheet();
                            if i != root.currency-index {
                                root.currency-index = i;
                                root.save-settings();
                            }
                        }
                    }
                }
            }
        }

        if root.sheet == SheetKind.bill-type : Sheet {
            title: "Bill type";
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            ScrollView {
                height: min(root.bill-type-names.length * 54px, root.height * 0.55);
                VerticalLayout {
                    spacing: 2px;
                    for name[i] in root.bill-type-names : SheetOption {
                        text: name;
                        selected: i == root.bill-type-index;
                        clicked => {
                            root.bill-type-index = i;
                            root.close-sheet();
                        }
                    }
                }
            }
        }

        if root.sheet == SheetKind.boarder-actions && root.sheet-index >= 0 && root.sheet-index < root.boarders.length : actions-sheet := Sheet {
            property <BoarderRow> boarder: root.boarders[root.sheet-index];
            title: actions-sheet.boarder.name;
            subtitle: actions-sheet.boarder.archived ? "Archived" : (actions-sheet.boarder.has-due ? actions-sheet.boarder.amount + " outstanding" : "Paid up");
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            VerticalLayout {
                spacing: 2px;
                SheetOption {
                    text: "View ledger";
                    icon: Icons.person;
                    clicked => {
                        let index = root.sheet-index;
                        root.close-sheet();
                        root.open-ledger(index);
                    }
                }
                SheetOption {
                    text: "Rename";
                    icon: Icons.pencil;
                    clicked => {
                        root.rename-name = actions-sheet.boarder.name;
                        root.open-sheet(SheetKind.rename, root.sheet-index);
                    }
                }
                SheetOption {
                    text: actions-sheet.boarder.archived ? "Restore boarder" : "Archive boarder";
                    icon: Icons.archive;
                    tone: actions-sheet.boarder.archived ? Tone.neutral : Tone.danger;
                    clicked => {
                        let index = root.sheet-index;
                        root.close-sheet();
                        root.archive-boarder(index);
                    }
                }
                SheetOption {
                    text: "Delete boarder";
                    icon: Icons.trash;
                    tone: Tone.danger;
                    clicked => {
                        let index = root.sheet-index;
                        root.close-sheet();
                        root.open-sheet(SheetKind.delete-boarder, index);
                    }
                }
            }
        }

        if root.sheet == SheetKind.delete-boarder && root.sheet-index >= 0 && root.sheet-index < root.boarders.length : delete-sheet := Sheet {
            title: "Delete " + delete-sheet.boarder.name + "?";
            error: root.sheet-error;
            clear-error => { root.clear-error(); }
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            property <BoarderRow> boarder: root.boarders[root.sheet-index];

            Text {
                text: "This removes the boarder from the list and can't be undone. Boarders with past bills can't be deleted; archive them instead.";
                font-size: Theme.text-sub;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            AppButton {
                text: "Delete boarder";
                icon: Icons.trash;
                kind: ButtonKind.danger;
                clicked => {
                    root.begin-action();
                    root.delete-boarder(root.sheet-index);
                    if !root.message-error { root.close-sheet(); }
                }
            }
            AppButton {
                text: "Keep boarder";
                kind: ButtonKind.secondary;
                clicked => { root.close-sheet(); }
            }
        }

        if root.sheet == SheetKind.delete-bill : Sheet {
            title: "Delete this bill?";
            subtitle: root.detail-title;
            error: root.sheet-error;
            clear-error => { root.clear-error(); }
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            Text {
                text: "This permanently deletes the bill, every boarder share on it, and all recorded payments. This can't be undone.";
                font-size: Theme.text-sub;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            AppButton {
                text: "Delete bill";
                icon: Icons.trash;
                kind: ButtonKind.danger;
                clicked => {
                    root.begin-action();
                    root.delete-bill();
                    if !root.message-error { root.close-sheet(); }
                }
            }
            AppButton {
                text: "Keep bill";
                kind: ButtonKind.secondary;
                clicked => { root.close-sheet(); }
            }
        }

        if root.sheet == SheetKind.rename && root.sheet-index >= 0 && root.sheet-index < root.boarders.length : Sheet {
            title: "Rename boarder";
            subtitle: "Past bills keep the name they were created with.";
            error: root.sheet-error;
            clear-error => { root.clear-error(); }
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            TextField {
                label: "Name";
                text <=> root.rename-name;
                accepted => { save.clicked(); }
            }
            save := AppButton {
                text: "Save name";
                icon: Icons.check;
                enabled: root.rename-name != "";
                clicked => {
                    if root.rename-name == "" { return; }
                    root.begin-action();
                    root.rename-boarder(root.sheet-index, root.rename-name);
                    if !root.message-error { root.close-sheet(); }
                }
            }
        }

        // ---- Calendar picker ----
        if root.sheet == SheetKind.calendar : CalendarSheet {
            title: root.calendar-title;
            bottom-inset: root.bottom-inset;
            days: root.calendar-days;
            month-names: root.month-names;
            year: root.calendar-year;
            month: root.calendar-month;
            header-label: root.calendar-header-label;
            month-only: root.calendar-month-only;
            allow-clear: root.calendar-allow-clear;
            include-time: root.calendar-include-time;
            hour: root.calendar-hour;
            minute: root.calendar-minute;
            pm: root.calendar-pm;
            time-label: root.calendar-time-label;
            dismiss => { root.close-sheet(); }
            prev-month => { root.calendar-prev-month(); }
            next-month => { root.calendar-next-month(); }
            pick(iso) => {
                root.calendar-pick(iso);
                if !root.calendar-include-time {
                    if root.detail-correcting {
                        root.detail-correcting = false;
                        root.open-sheet(SheetKind.payment-detail, -1);
                    } else {
                        root.close-sheet();
                    }
                }
            }
            today => {
                root.calendar-today();
                if root.calendar-month-only {
                    root.close-sheet();
                } else if !root.calendar-include-time {
                    if root.detail-correcting {
                        root.detail-correcting = false;
                        root.open-sheet(SheetKind.payment-detail, -1);
                    } else {
                        root.close-sheet();
                    }
                }
            }
            clear => {
                root.calendar-clear();
                root.close-sheet();
            }
            confirm => {
                root.calendar-confirm();
                root.close-sheet();
            }
            time-changed(h, m, pm) => { root.calendar-time-changed(h, m, pm); }
            pick-month(m) => {
                root.calendar-pick-month(m);
                if root.calendar-month-only { root.close-sheet(); }
            }
            pick-year(y) => { root.calendar-pick-year(y); }
        }

        // ---- Manage shares ----
        if root.sheet == SheetKind.manage-shares : Sheet {
            title: "Manage shares";
            subtitle: root.manage-subtitle;
            error: root.sheet-error;
            clear-error => { root.clear-error(); }
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            if root.detail-archived : Banner {
                text: "This bill is archived. Changes apply immediately and are kept if you restore it.";
                warning: true;
                dismissible: false;
            }

            if root.manage-pending >= 0 && root.manage-pending < root.manage-rows.length : confirm-col := VerticalLayout {
                property <ManageRow> target: root.manage-rows[root.manage-pending];
                spacing: Theme.space-3;

                Text {
                    text: "Exclude " + confirm-col.target.name + " from this bill?";
                    font-size: Theme.text-headline;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: "Their " + confirm-col.target.amount + " share is split equally among the remaining "
                        + (root.manage-rows.length - 1) + " boarders. The bill total stays " + root.detail-total + ".";
                    font-size: Theme.text-sub;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                AppButton {
                    text: "Exclude from this bill";
                    icon: Icons.ban;
                    kind: ButtonKind.danger;
                    clicked => {
                        root.begin-action();
                        root.manage-exclude(root.manage-pending);
                        if !root.message-error { root.close-sheet(); }
                    }
                }
                AppButton {
                    text: "Keep on bill";
                    kind: ButtonKind.secondary;
                    clicked => { root.manage-pending = -1; }
                }
            }

            if root.manage-pending < 0 : VerticalLayout {
                spacing: Theme.space-3;

                ListCard {
                    for row[i] in root.manage-rows : Rectangle {
                        height: 64px;

                        if i > 0 : Rectangle {
                            x: Theme.space-3;
                            width: parent.width - Theme.space-3;
                            height: 1px;
                            background: Theme.divider;
                        }

                        HorizontalLayout {
                            padding-left: Theme.space-4;
                            padding-right: Theme.space-3;
                            spacing: Theme.space-2;

                            Text {
                                text: row.name;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                font-size: Theme.text-body;
                                font-weight: Theme.weight-semibold;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: row.amount;
                                vertical-alignment: center;
                                font-size: Theme.text-sub;
                                font-weight: Theme.weight-semibold;
                                color: Theme.text-muted;
                            }
                            AppButton {
                                text: "Edit";
                                kind: ButtonKind.ghost;
                                compact: true;
                                clicked => {
                                    root.begin-action();
                                    root.manage-edit(i);
                                    if !root.message-error { root.open-sheet(SheetKind.edit-share, root.share-edit-target); }
                                }
                            }
                            AppButton {
                                text: "Exclude";
                                kind: ButtonKind.danger-soft;
                                compact: true;
                                clicked => { root.manage-pending = i; }
                            }
                        }
                    }
                }

                if root.manage-candidates.length > 0 : VerticalLayout {
                    spacing: Theme.space-2;
                    SectionHeader { title: "Add boarder"; }
                    ListCard {
                        for name[j] in root.manage-candidates : SheetOption {
                            text: name;
                            icon: Icons.plus;
                            clicked => {
                                root.begin-action();
                                root.manage-add(j);
                                if !root.message-error { root.close-sheet(); }
                            }
                        }
                    }
                }

                Text {
                    text: "Excluding a boarder keeps the bill total and splits it equally among the remaining boarders. It only affects this bill.";
                    font-size: Theme.text-caption;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
        }

        // ---- Return change confirmation ----
        if root.sheet == SheetKind.return-change : Sheet {
            title: "Return change?";
            subtitle: root.return-change-subtitle;
            error: root.sheet-error;
            clear-error => { root.clear-error(); }
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            ListCard {
                DetailRow {
                    label: "Amount to return";
                    value: root.return-change-amount;
                }
                DetailRow {
                    label: "Returned on";
                    value: root.return-change-date-label;
                    tappable: true;
                    clicked => {
                        root.return-change-pick-date();
                        root.open-sheet(SheetKind.calendar, -1);
                    }
                }
            }

            TextField {
                label: "Note (optional)";
                placeholder: "e.g. handed to Maria";
                text <=> root.return-change-note;
            }

            AppButton {
                text: "Confirm returned";
                icon: Icons.check;
                clicked => {
                    root.begin-action();
                    root.return-change-confirm();
                    if !root.message-error { root.close-sheet(); }
                }
            }
            AppButton {
                text: "Cancel";
                kind: ButtonKind.secondary;
                clicked => { root.close-sheet(); }
            }
        }

        // ---- Payment detail (read only) ----
        if root.sheet == SheetKind.payment-detail : Sheet {
            title: "Payment";
            subtitle: root.pd-subtitle;
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            if root.pd-voided : Banner {
                text: "Voided: " + root.pd-void-reason;
                error: true;
                dismissible: false;
            }

            ListCard {
                DetailRow { label: "Total Bill"; value: root.pd-total; }
                DetailRow { label: "Amount Received"; value: root.pd-received; }
                DetailRow { label: "Change Returned"; value: root.pd-change-returned; }
                DetailRow { label: "Net Payment"; value: root.pd-net; }
                HorizontalLayout {
                    height: 44px;
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-2;
                    Text {
                        text: "Payment Status";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        font-size: Theme.text-sub;
                        color: Theme.text-muted;
                    }
                    StatusPill {
                        text: root.pd-payment-status;
                        tone: Theme.status-tone(root.pd-payment-status);
                    }
                }
                HorizontalLayout {
                    height: 44px;
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-2;
                    Text {
                        text: "Change Status";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        font-size: Theme.text-sub;
                        color: Theme.text-muted;
                    }
                    if root.pd-change-status != "" : StatusPill {
                        text: root.pd-change-status;
                        tone: root.pd-change-status == "Change to Return" ? Tone.warning : Tone.success;
                    }
                    if root.pd-change-status == "" : Text {
                        text: "—";
                        vertical-alignment: center;
                        font-size: Theme.text-body;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text-muted;
                    }
                }
                DetailRow { label: "Recorded"; value: root.pd-recorded; }
                if root.pd-has-returned : DetailRow {
                    label: "Returned on";
                    value: root.pd-returned-on;
                    tappable: true;
                    clicked => {
                        root.payment-detail-correct-date();
                        root.detail-correcting = true;
                        root.open-sheet(SheetKind.calendar, -1);
                    }
                }
            }

            if root.pd-can-return : AppButton {
                text: "Return change";
                icon: Icons.undo;
                clicked => {
                    root.begin-action();
                    root.payment-detail-return();
                    if !root.message-error {
                        root.close-sheet();
                        root.open-sheet(SheetKind.return-change, -1);
                    }
                }
            }
            AppButton {
                text: "Close";
                kind: ButtonKind.secondary;
                clicked => { root.close-sheet(); }
            }
        }

        if root.sheet == SheetKind.restore : Sheet {
            title: "Restore from backup?";
            bottom-inset: root.bottom-inset;
            dismiss => { root.close-sheet(); }

            Text {
                text: "This replaces everything on this device with the newest backup file in the app folder. Export a backup first if you want to keep the current data.";
                font-size: Theme.text-sub;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            AppButton {
                text: "Replace with backup";
                icon: Icons.upload;
                kind: ButtonKind.danger;
                clicked => {
                    root.close-sheet();
                    root.import-backup();
                }
            }
            AppButton {
                text: "Cancel";
                kind: ButtonKind.secondary;
                clicked => { root.close-sheet(); }
            }
        }

        // ---- Overpayment notice: above every sheet and the navigation ----
        if root.overpay-shown : Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;

            OverpaymentDialog {
                width: 100%;
                height: 100%;
                subtitle: root.overpay-subtitle;
                amount: root.overpay-amount;
                change: root.overpay-change;
                due: root.overpay-due;
                dismiss => {
                    root.overpay-dismiss();
                    root.overpay-shown = false;
                }
                return-change => {
                    root.begin-action();
                    root.overpay-return-change();
                    if !root.message-error {
                        root.overpay-shown = false;
                        root.open-sheet(SheetKind.return-change, -1);
                    }
                }
            }
        }
    }
}
