import { Theme, Tone, Icon, Icons, Card, AppButton, ButtonKind, StatusPill, ProgressBar, SectionHeader, EmptyState } from "../components.slint";
import { Page, Section, ListCard, ListRow, SummaryMetrics } from "../layout.slint";
import { ShareRow, PaymentRow } from "../models.slint";

// A payment line, shared by the bill and boarder ledger screens.
export component PaymentItem inherits ListRow {
    in property <PaymentRow> payment;
    in property <bool> actions: false;
    callback return-change();
    callback void();

    tappable: false;
    label: root.payment.title + ", " + root.payment.amount + (root.payment.voided ? ", voided" : "");

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-1;

        HorizontalLayout {
            spacing: Theme.space-2;
            Text {
                text: root.payment.title;
                horizontal-stretch: 1;
                font-size: Theme.text-body;
                font-weight: Theme.weight-semibold;
                color: root.payment.voided ? Theme.text-muted : Theme.text;
                overflow: elide;
            }
            Text {
                text: root.payment.amount;
                font-size: Theme.text-body;
                font-weight: Theme.weight-semibold;
                color: root.payment.voided ? Theme.text-muted : Theme.success;
            }
        }
        Text {
            text: root.payment.subtitle;
            font-size: Theme.text-sub;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        if root.payment.has-change && !root.payment.voided : Text {
            text: root.payment.change + (root.payment.can-return ? " change to return" : " change");
            font-size: Theme.text-sub;
            color: root.payment.can-return ? Theme.warning : Theme.text-muted;
        }
        if root.payment.voided : HorizontalLayout {
            alignment: start;
            padding-top: Theme.space-1;
            StatusPill {
                text: "Voided";
                tone: Tone.neutral;
            }
        }
        if root.actions && !root.payment.voided : HorizontalLayout {
            alignment: start;
            spacing: Theme.space-2;
            padding-top: Theme.space-2;
            if root.payment.can-return : AppButton {
                text: "Mark change returned";
                icon: Icons.undo;
                kind: ButtonKind.secondary;
                compact: true;
                clicked => { root.return-change(); }
            }
            AppButton {
                text: "Void";
                icon: Icons.ban;
                kind: ButtonKind.danger-soft;
                compact: true;
                clicked => { root.void(); }
            }
        }
    }
}

export component BillScreen {
    in property <length> bottom-inset;
    in property <string> detail-title;
    in property <string> detail-subtitle;
    in property <string> detail-status;
    in property <bool> detail-archived;
    in property <string> detail-expected;
    in property <string> detail-collected;
    in property <string> detail-outstanding;
    in property <string> detail-change;
    in property <float> detail-progress;
    in property <[ShareRow]> shares;
    in property <[PaymentRow]> payments;

    callback pay(int);
    callback void-payment(int);
    callback return-change(int);
    callback archive-bill();

    Page {
        width: 100%;
        height: 100%;
        bottom-inset: root.bottom-inset;

        // ---- Summary ----
        Card {
            VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-4;

                HorizontalLayout {
                    spacing: Theme.space-3;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: root.detail-title;
                            font-size: Theme.text-title;
                            font-weight: Theme.weight-bold;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.detail-subtitle;
                            font-size: Theme.text-sub;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        StatusPill {
                            text: root.detail-archived ? "Archived" : root.detail-status;
                            tone: root.detail-archived ? Tone.neutral : Theme.status-tone(root.detail-status);
                        }
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Outstanding";
                        font-size: Theme.text-sub;
                        font-weight: Theme.weight-medium;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: root.detail-outstanding;
                        font-size: Theme.text-display - 4px;
                        font-weight: Theme.weight-bold;
                        letter-spacing: -0.5px;
                        color: Theme.text;
                    }
                }
                ProgressBar {
                    value: root.detail-progress;
                    tone: root.detail-progress >= 1 ? Tone.success : Tone.accent;
                }
                SummaryMetrics {
                    collected: root.detail-collected;
                    expected: root.detail-expected;
                    change: root.detail-change;
                }
            }
        }

        // ---- Shares ----
        Section {
            SectionHeader {
                title: "Shares";
                caption: "Tap Pay to record money received";
            }
            ListCard {
                for share[i] in root.shares : ListRow {
                    show-divider: i > 0;
                    tappable: false;
                    label: share.name + ", " + share.status + ", balance " + share.balance;

                    HorizontalLayout {
                        padding-left: Theme.space-4;
                        padding-right: Theme.space-3;
                        padding-top: Theme.space-3;
                        padding-bottom: Theme.space-3;
                        spacing: Theme.space-3;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text {
                                    text: share.name;
                                    font-size: Theme.text-body;
                                    font-weight: Theme.weight-semibold;
                                    color: Theme.text;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                StatusPill {
                                    text: share.status;
                                    tone: Theme.status-tone(share.status);
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text {
                                text: share.has-balance ? share.balance + " left to pay" : "Fully paid";
                                font-size: Theme.text-sub;
                                font-weight: Theme.weight-medium;
                                color: share.has-balance ? Theme.danger : Theme.success;
                            }
                            Text {
                                text: share.paid + " paid of " + share.due;
                                font-size: Theme.text-sub;
                                color: Theme.text-muted;
                                overflow: elide;
                            }
                            if share.has-change : Text {
                                text: share.change + " change to return";
                                font-size: Theme.text-sub;
                                color: Theme.warning;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            AppButton {
                                text: "Pay";
                                icon: Icons.cash;
                                compact: true;
                                kind: share.has-balance ? ButtonKind.primary : ButtonKind.secondary;
                                clicked => { root.pay(i); }
                            }
                        }
                    }
                }
            }
        }

        // ---- Payments ----
        Section {
            SectionHeader {
                title: "Payments";
                caption: root.payments.length == 0 ? "" : root.payments.length == 1 ? "1 payment, newest first" : root.payments.length + " payments, newest first";
            }
            if root.payments.length == 0 : Card {
                EmptyState {
                    icon: Icons.cash;
                    title: "No payments yet";
                    body: "Payments you record on a share appear here.";
                }
            }
            if root.payments.length > 0 : ListCard {
                for payment[i] in root.payments : PaymentItem {
                    show-divider: i > 0;
                    payment: payment;
                    actions: true;
                    return-change => { root.return-change(i); }
                    void => { root.void-payment(i); }
                }
            }
        }

        // ---- Archive ----
        VerticalLayout {
            spacing: Theme.space-2;
            AppButton {
                text: root.detail-archived ? "Restore bill" : "Archive bill";
                icon: Icons.archive;
                kind: ButtonKind.secondary;
                clicked => { root.archive-bill(); }
            }
            Text {
                text: root.detail-archived
                    ? "Restoring shows this bill on the dashboard again."
                    : "Archiving hides this bill from the dashboard totals. You can restore it later.";
                horizontal-alignment: center;
                font-size: Theme.text-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }
}
