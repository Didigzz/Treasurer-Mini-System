import { Theme, Tone, Icon, Icons, Card, AppButton, ButtonKind, StatusPill, ProgressBar, SectionHeader, EmptyState, TextField, Segmented } from "../components.slint";
import { Page, Section, ListCard, ListRow, SummaryMetrics } from "../layout.slint";
import { ShareRow, PaymentRow } from "../models.slint";

// A payment line, shared by the bill and boarder ledger screens.
export component PaymentItem inherits ListRow {
    in property <PaymentRow> payment;
    in property <bool> actions: false;
    // Archived bills hide Undo until the bill is restored.
    in property <bool> allow-undo: true;
    callback return-change();
    callback undo();
    callback open-payment();

    tappable: true;
    label: root.payment.title + ", " + root.payment.amount + ", " + root.payment.payment-type + ", " + root.payment.status + (root.payment.voided ? ", undone" : ", opens payment detail");
    clicked => { root.open-payment(); }

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-1;

        HorizontalLayout {
            spacing: Theme.space-2;
            Text {
                text: root.payment.title;
                horizontal-stretch: 1;
                font-size: Theme.text-body;
                font-weight: Theme.weight-semibold;
                color: root.payment.voided ? Theme.text-muted : Theme.text;
                overflow: elide;
            }
            Text {
                text: root.payment.amount;
                font-size: Theme.text-body;
                font-weight: Theme.weight-semibold;
                color: root.payment.voided ? Theme.text-muted : Theme.success;
            }
        }
        Text {
            text: root.payment.subtitle;
            font-size: Theme.text-sub;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        if !root.payment.voided : HorizontalLayout {
            alignment: start;
            padding-top: Theme.space-1;
            StatusPill {
                text: root.payment.status;
                tone: Tone.success;
            }
        }
        if root.payment.change-status != "" && !root.payment.voided : HorizontalLayout {
            alignment: start;
            StatusPill {
                text: root.payment.change-status;
                tone: root.payment.can-return ? Tone.warning : Tone.success;
            }
        }
        if root.payment.voided : HorizontalLayout {
            alignment: start;
            padding-top: Theme.space-1;
            StatusPill {
                text: "Undone";
                tone: Tone.neutral;
            }
        }
        if root.allow-undo && !root.payment.voided : HorizontalLayout {
            alignment: start;
            spacing: Theme.space-2;
            padding-top: Theme.space-2;
            if root.actions && root.payment.can-return : AppButton {
                text: "Return change";
                icon: Icons.undo;
                kind: ButtonKind.secondary;
                compact: true;
                clicked => { root.return-change(); }
            }
            AppButton {
                text: "Undo payment";
                describe: "Undo payment for " + root.payment.title + ", " + root.payment.amount;
                icon: Icons.undo;
                kind: ButtonKind.danger-soft;
                compact: true;
                clicked => { root.undo(); }
            }
        }
    }
}

export component BillScreen {
    in property <length> bottom-inset;
    in property <string> detail-title;
    in property <string> detail-subtitle;
    in property <string> detail-status;
    in property <bool> detail-archived;
    in property <string> detail-expected;
    in property <string> detail-collected;
    in property <string> detail-outstanding;
    in property <string> detail-change;
    in property <float> detail-progress;
    in property <[ShareRow]> shares;
    in property <[PaymentRow]> payments;

    in-out property <string> share-filter: "";
    in-out property <int> share-filter-mode: 0;
    in-out property <int> share-type-filter: 0;
    in property <string> share-type-collected-caption: "";
    in property <string> share-type-collected: "";
    in property <int> share-total-count: 0;
    in property <int> share-visible-count: 0;

    callback pay(int);
    callback undo-payment(int);
    callback undo-share(int);
    callback return-change(int);
    callback archive-bill();
    callback delete-bill();
    callback set-share-filter(string);
    callback set-share-filter-mode(int);
    callback set-share-type-filter(int);
    callback edit-share(int);
    callback manage-shares();
    callback open-payment(int);
    callback return-share-change(int);

    Page {
        width: 100%;
        height: 100%;
        bottom-inset: root.bottom-inset;

        // ---- Summary ----
        Card {
            VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-4;

                HorizontalLayout {
                    spacing: Theme.space-3;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: root.detail-title;
                            font-size: Theme.text-title;
                            font-weight: Theme.weight-bold;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.detail-subtitle;
                            font-size: Theme.text-sub;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        StatusPill {
                            text: root.detail-archived ? "Archived" : root.detail-status;
                            tone: root.detail-archived ? Tone.neutral : Theme.status-tone(root.detail-status);
                        }
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Outstanding";
                        font-size: Theme.text-sub;
                        font-weight: Theme.weight-medium;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: root.detail-outstanding;
                        font-size: Theme.text-display - 4px;
                        font-weight: Theme.weight-bold;
                        letter-spacing: -0.5px;
                        color: Theme.text;
                    }
                }
                ProgressBar {
                    value: root.detail-progress;
                    tone: root.detail-progress >= 1 ? Tone.success : Tone.accent;
                }
                SummaryMetrics {
                    collected: root.detail-collected;
                    expected: root.detail-expected;
                    change: root.detail-change;
                }
            }
        }

        // ---- Shares ----
        Section {
            SectionHeader {
                title: "Shares";
                caption: root.share-total-count == 0
                    ? "Tap a name to edit the split"
                    : (root.share-filter != "" || root.share-filter-mode != 0 || root.share-type-filter != 0)
                        ? root.share-visible-count + " of " + root.share-total-count + " boarders"
                        : root.share-total-count + (root.share-total-count == 1 ? " boarder" : " boarders");
                action-text: "Manage";
                action-icon: Icons.sliders;
                action => { root.manage-shares(); }
            }

            if root.share-total-count > 0 : VerticalLayout {
                spacing: Theme.space-2;
                TextField {
                    placeholder: "Find a boarder";
                    text <=> root.share-filter;
                    edited(value) => { root.set-share-filter(value); }
                }
                Segmented {
                    options: ["All", "Unpaid", "Paid"];
                    selected: root.share-filter-mode;
                    label: "Filter shares by status";
                    select(i) => { root.set-share-filter-mode(i); }
                }
                Segmented {
                    options: ["All", "Cash", "Online"];
                    selected: root.share-type-filter;
                    label: "Filter shares by payment type";
                    select(i) => { root.set-share-type-filter(i); }
                }
                if root.share-type-filter != 0 : HorizontalLayout {
                    padding-top: Theme.space-1;
                    spacing: Theme.space-2;
                    Text {
                        text: root.share-type-collected-caption;
                        accessible-label: root.share-type-collected-caption + ", " + root.share-type-collected;
                        horizontal-stretch: 1;
                        font-size: Theme.text-sub;
                        font-weight: Theme.weight-medium;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                    Text {
                        text: root.share-type-collected;
                        font-size: Theme.text-sub;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text;
                    }
                }
            }

            if root.share-total-count > 0 && root.shares.length == 0 : Card {
                EmptyState {
                    icon: Icons.people;
                    title: "No boarders match";
                    body: "Try another name or filter.";
                    action-text: "Clear filter";
                    action => {
                        root.set-share-filter("");
                        root.set-share-filter-mode(0);
                        root.set-share-type-filter(0);
                    }
                }
            }

            if root.shares.length > 0 : ListCard {
                for share[i] in root.shares : ListRow {
                    show-divider: i > 0;
                    tappable: false;
                    label: share.name + ", " + share.status + ", balance " + share.balance
                        + (share.has-charge ? ", includes " + share.charge + " additional charge" : "")
                        + ", opens share editor";

                    HorizontalLayout {
                        padding-left: Theme.space-4;
                        padding-right: Theme.space-3;
                        padding-top: Theme.space-3;
                        padding-bottom: Theme.space-3;
                        spacing: Theme.space-3;

                        // Tappable left region: opens the share editor. The Pay
                        // button keeps its own tap target and is outside it.
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: Theme.radius-md;
                            background: left-touch.pressed ? Theme.surface-pressed : transparent;
                            accessible-role: button;
                            accessible-label: share.name + ", " + share.status + ", balance " + share.balance
                                + (share.has-charge ? ", includes " + share.charge + " additional charge" : "")
                                + ", opens share editor";
                            accessible-action-default => { root.edit-share(i); }

                            animate background { duration: Theme.fast; }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                HorizontalLayout {
                                    spacing: Theme.space-3;
                                    // The name absorbs the slack so the status pill
                                    // and chevron hold one right-hand column no
                                    // matter how long the boarder's name is.
                                    Text {
                                        text: share.name;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        font-size: Theme.text-body;
                                        font-weight: Theme.weight-semibold;
                                        color: Theme.text;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    StatusPill {
                                        text: share.status;
                                        tone: Theme.status-tone(share.status);
                                    }
                                    Icon {
                                        path: Icons.chevron-right;
                                        color: Theme.text-faint;
                                        size: 16px;
                                    }
                                }
                                Text {
                                    text: share.has-balance ? share.balance + " left to pay" : "Fully paid";
                                    font-size: Theme.text-sub;
                                    font-weight: Theme.weight-medium;
                                    color: share.has-balance ? Theme.danger : Theme.success;
                                }
                                Text {
                                    text: share.paid + " paid of " + share.due;
                                    font-size: Theme.text-sub;
                                    color: Theme.text-muted;
                                    overflow: elide;
                                }
                                if share.has-charge : Text {
                                    text: "+ " + share.charge + " additional charge";
                                    font-size: Theme.text-sub;
                                    color: Theme.warning;
                                    overflow: elide;
                                }
                                if share.has-change-status : Rectangle {
                                    height: 28px;
                                    Text {
                                        text: share.change-status;
                                        font-size: Theme.text-sub;
                                        color: share.has-change ? Theme.warning : Theme.success;
                                        vertical-alignment: center;
                                    }
                                    change-touch := TouchArea {
                                        enabled: share.has-change;
                                        clicked => { root.return-share-change(i); }
                                    }
                                }
                            }

                            left-touch := TouchArea {
                                clicked => { root.edit-share(i); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.space-2;
                            AppButton {
                                text: "Pay";
                                icon: Icons.cash;
                                compact: true;
                                kind: share.has-balance ? ButtonKind.primary : ButtonKind.secondary;
                                clicked => { root.pay(i); }
                            }
                            if share.settled && !root.detail-archived : AppButton {
                                text: "Undo payment";
                                describe: "Undo payment for " + share.name + ", " + share.paid + " paid";
                                icon: Icons.undo;
                                kind: ButtonKind.danger-soft;
                                compact: true;
                                clicked => { root.undo-share(i); }
                            }
                        }
                    }
                }
            }
        }

        // ---- Payments ----
        Section {
            SectionHeader {
                title: "Payments";
                caption: root.payments.length == 0 ? "" : root.payments.length == 1 ? "1 payment, newest first" : root.payments.length + " payments, newest first";
            }
            if root.payments.length == 0 : Card {
                EmptyState {
                    icon: Icons.cash;
                    title: "No payments yet";
                    body: "Payments you record on a share appear here.";
                }
            }
            if root.payments.length > 0 : ListCard {
                for payment[i] in root.payments : PaymentItem {
                    show-divider: i > 0;
                    payment: payment;
                    actions: true;
                    allow-undo: !root.detail-archived;
                    return-change => { root.return-change(i); }
                    undo => { root.undo-payment(i); }
                    open-payment => { root.open-payment(i); }
                }
            }
        }

        // ---- Archive ----
        VerticalLayout {
            spacing: Theme.space-2;
            AppButton {
                text: root.detail-archived ? "Restore bill" : "Archive bill";
                icon: Icons.archive;
                kind: ButtonKind.secondary;
                clicked => { root.archive-bill(); }
            }
            Text {
                text: root.detail-archived
                    ? "Restoring shows this bill on the dashboard again."
                    : "Archiving hides this bill from the dashboard totals. You can restore it later.";
                horizontal-alignment: center;
                font-size: Theme.text-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            AppButton {
                text: "Delete bill";
                icon: Icons.trash;
                kind: ButtonKind.danger-soft;
                clicked => { root.delete-bill(); }
            }
            Text {
                text: "Deleting removes this bill, every boarder share on it, and all its payments. This can't be undone.";
                horizontal-alignment: center;
                font-size: Theme.text-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }
}
