import { Theme, Tone, Icon, Icons, Card, AppButton, ButtonKind, TextField, SelectField, SectionHeader, EmptyState } from "../components.slint";
import { Page, Section, ListCard, ListRow, Responsive } from "../layout.slint";
import { PickRow } from "../models.slint";

component Checkmark inherits Rectangle {
    in property <bool> checked;
    in property <bool> indeterminate: false;

    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: checked && !indeterminate ? Theme.accent : transparent;
    border-width: checked && !indeterminate ? 0 : 2px;
    border-color: checked || indeterminate ? Theme.accent : Theme.text-faint;

    animate background { duration: Theme.fast; }

    if checked && !indeterminate : Icon {
        path: Icons.check;
        color: Theme.on-accent;
        size: 16px;
        stroke-width: 2.6px;
    }

    if indeterminate : Rectangle {
        width: 12px;
        height: 2px;
        border-radius: 1px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.accent;
    }
}

export component NewBillScreen {
    in property <length> bottom-inset;
    in property <string> bill-type-label;
    in property <bool> has-bill-types;
    in property <[PickRow]> picks;
    in property <int> picks-selected-count: 0;
    in property <int> picks-total-count: 0;
    in property <bool> picks-all-selected: false;
    in property <bool> picks-some-selected: false;
    in property <string> bill-period-label;
    in property <string> bill-due-label;
    in-out property <string> bill-total;
    in-out property <string> bill-note;

    callback pick-type();
    callback pick-period();
    callback pick-due();
    callback pick-toggle(int);
    callback pick-amount(int, string);
    callback select-all-picks();
    callback create-bill();
    callback go-settings();
    callback go-boarders();

    // "17 of 20 selected"; never hidden, even at zero.
    property <string> count-label: root.picks-total-count == 0
        ? "0 selected"
        : root.picks-selected-count + " of " + root.picks-total-count + " selected";
    property <string> select-all-label: "Select all tenants, " + root.count-label
        + (root.picks-some-selected ? ", partially selected"
            : root.picks-all-selected ? ", selected" : ", not selected");

    VerticalLayout {
        width: 100%;
        height: 100%;
        Page {
            vertical-stretch: 1;
            bottom-inset: 0px;

            Section {
                SectionHeader { title: "Details"; }
                Card {
                    VerticalLayout {
                        padding: Theme.space-4;
                        spacing: Theme.space-4;

                        SelectField {
                            label: "Bill type";
                            value: root.has-bill-types ? root.bill-type-label : "";
                            placeholder: "No bill types yet";
                            clicked => {
                                if root.has-bill-types { root.pick-type(); } else { root.go-settings(); }
                            }
                        }
                        if !root.has-bill-types : HorizontalLayout {
                            alignment: start;
                            AppButton {
                                text: "Add a bill type in Settings";
                                kind: ButtonKind.ghost;
                                compact: true;
                                clicked => { root.go-settings(); }
                            }
                        }

                        TextField {
                            label: "Total amount";
                            placeholder: "0.00";
                            text <=> root.bill-total;
                        }

                        SelectField {
                            label: "Billing month";
                            value: root.bill-period-label;
                            placeholder: "Choose a month";
                            clicked => { root.pick-period(); }
                        }

                        SelectField {
                            label: "Due date (optional)";
                            value: root.bill-due-label;
                            placeholder: "No due date";
                            clicked => { root.pick-due(); }
                        }

                        TextField {
                            label: "Note (optional)";
                            placeholder: "e.g. Reading Oct 12 – Nov 11";
                            text <=> root.bill-note;
                        }
                    }
                }
            }

            Section {
                SectionHeader {
                    title: "Split among";
                    caption: root.count-label + ". Leave amounts empty to split equally. A typed amount is fixed; the rest are split equally. You can edit or exclude boarders after the bill is created.";
                }

                if root.picks.length == 0 : Card {
                    EmptyState {
                        icon: Icons.people;
                        title: "No active boarders";
                        body: "Add boarders before creating a bill.";
                        action-text: "Go to Boarders";
                        action => { root.go-boarders(); }
                    }
                }

                if root.picks.length > 0 : ListCard {
                    ListRow {
                        show-divider: false;
                        label: root.select-all-label;
                        clicked => { root.select-all-picks(); }

                        HorizontalLayout {
                            padding-left: Theme.space-4;
                            padding-right: Theme.space-4;
                            padding-top: Theme.space-2;
                            padding-bottom: Theme.space-2;
                            spacing: Theme.space-3;

                            VerticalLayout {
                                alignment: center;
                                Checkmark {
                                    checked: root.picks-all-selected;
                                    indeterminate: root.picks-some-selected;
                                }
                            }
                            Text {
                                text: "Select all";
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                font-size: Theme.text-body;
                                font-weight: Theme.weight-semibold;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: root.count-label;
                                vertical-alignment: center;
                                font-size: Theme.text-caption;
                                color: Theme.text-muted;
                                overflow: elide;
                            }
                        }
                    }
                }

                if root.picks.length > 0 : ListCard {
                    for pick[i] in root.picks : ListRow {
                        show-divider: i > 0;
                        label: pick.name + (pick.selected ? ", selected" : ", not selected");
                        clicked => { root.pick-toggle(i); }

                        HorizontalLayout {
                            padding-left: Theme.space-4;
                            padding-right: Theme.space-3;
                            padding-top: Theme.space-2;
                            padding-bottom: Theme.space-2;
                            spacing: Theme.space-3;

                            VerticalLayout {
                                alignment: center;
                                Checkmark { checked: pick.selected; }
                            }
                            Text {
                                text: pick.name;
                                horizontal-stretch: 1;
                                // 88px floor: the name wraps to a second line
                                // before it is squeezed to a couple of glyphs.
                                min-width: 88px;
                                vertical-alignment: center;
                                font-size: Theme.text-body;
                                font-weight: pick.selected ? Theme.weight-semibold : Theme.weight-regular;
                                color: Theme.text;
                                wrap: word-wrap;
                                max-lines: 2;
                                overflow: elide;
                            }
                            if pick.selected : TextField {
                                width: Responsive.compact ? 104px : 128px;
                                placeholder: "Equal";
                                text: pick.amount;
                                edited(value) => { root.pick-amount(i, value); }
                            }
                        }
                    }
                }

                Text {
                    text: "A typed amount is fixed and the rest are split equally, so they always add up to the total. With an equal split, leftover centavos go to the first selected boarders.";
                    font-size: Theme.text-caption;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
        }

        // Sticky action bar, lifted above the keyboard / gesture area.
        Rectangle {
            background: Theme.bg;

            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.divider;
            }

            HorizontalLayout {
                padding-left: Responsive.gutter;
                padding-right: Responsive.gutter;
                padding-top: Theme.space-3;
                padding-bottom: Theme.space-3 + root.bottom-inset;
                spacing: Theme.space-3;

                Text {
                    text: Responsive.compact
                        ? root.picks-selected-count + " selected"
                        : root.count-label;
                    vertical-alignment: center;
                    font-size: Theme.text-sub;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-muted;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                AppButton {
                    text: "Create bill";
                    icon: Icons.check;
                    enabled: root.has-bill-types && root.picks.length > 0;
                    clicked => { root.create-bill(); }
                }
            }
        }
    }
}
