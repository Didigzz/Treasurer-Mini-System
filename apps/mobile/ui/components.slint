// Shared building blocks. Everything here reads from `Theme` so screens never
// hard-code colours, radii, or font sizes.

import { Theme, Tone } from "theme.slint";
import { Icon, Icons } from "icons.slint";

export { Theme, Tone, Icon, Icons }

export enum ButtonKind { primary, secondary, ghost, danger, danger-soft }

// ---------------------------------------------------------------------------
// Surfaces
// ---------------------------------------------------------------------------

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;

    // A layout makes every child fill the card's width, so wrapped text
    // inside components (e.g. EmptyState) wraps instead of overflowing.
    VerticalLayout {
        @children
    }
}

// A card that is itself the tap target (whole-row navigation).
export component TapCard inherits Rectangle {
    in property <string> label;
    callback clicked();

    background: touch.pressed ? Theme.surface-pressed : Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    animate background { duration: Theme.fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    @children
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

// ---------------------------------------------------------------------------
// Buttons
// ---------------------------------------------------------------------------

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <ButtonKind> kind: ButtonKind.primary;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback clicked();

    property <color> fg: kind == ButtonKind.primary ? Theme.on-accent
        : kind == ButtonKind.danger ? #FFFFFF
        : kind == ButtonKind.danger-soft ? Theme.danger
        : kind == ButtonKind.ghost ? Theme.accent
        : Theme.text;
    property <color> base: kind == ButtonKind.primary ? Theme.accent
        : kind == ButtonKind.danger ? Theme.danger
        : kind == ButtonKind.danger-soft ? Theme.danger-soft
        : kind == ButtonKind.ghost ? transparent
        : Theme.surface-sunken;
    property <color> pressed-bg: kind == ButtonKind.primary ? Theme.accent-pressed
        : kind == ButtonKind.danger ? Theme.danger.darker(0.15)
        : kind == ButtonKind.danger-soft ? Theme.danger-soft.darker(0.06)
        : Theme.surface-pressed;

    height: compact ? 40px : 48px;
    min-width: compact ? 40px : 64px;
    // Hug the label in rows; callers opt into full width explicitly.
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    background: touch.pressed && enabled ? pressed-bg : base;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    animate background { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: root.compact ? 12px : 18px;
        padding-right: root.compact ? 12px : 18px;
        spacing: 8px;
        alignment: center;

        if root.icon != "" : Icon {
            path: root.icon;
            color: root.fg;
            size: root.compact ? 18px : 20px;
        }
        if root.text != "" : Text {
            text: root.text;
            color: root.fg;
            font-size: root.compact ? Theme.text-sub : Theme.text-body;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <brush> tint: Theme.text;
    in property <bool> filled: false;
    in property <length> icon-size: 22px;
    callback clicked();

    width: Theme.touch;
    height: Theme.touch;
    border-radius: self.height / 2;
    background: touch.pressed ? Theme.surface-pressed : (filled ? Theme.surface-sunken : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    animate background { duration: Theme.fast; }

    Icon {
        path: root.icon;
        color: root.tint;
        size: root.icon-size;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// Form controls
// ---------------------------------------------------------------------------

export component FieldLabel inherits Text {
    font-size: Theme.text-sub;
    font-weight: Theme.weight-semibold;
    color: Theme.text-muted;
}

// Single-line text field with a visible label. Built on TextInput so it looks
// the same under every Slint widget style (Fluent on desktop, Material on
// Android).
export component TextField {
    in property <string> label;
    in property <string> placeholder;
    in property <string> hint;
    in property <InputType> input-type: InputType.text;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);

    forward-focus: input;

    VerticalLayout {
        spacing: 6px;

        if root.label != "" : FieldLabel { text: root.label; }

        box := Rectangle {
            height: Theme.field-height;
            border-radius: Theme.radius-md;
            background: Theme.surface-sunken;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;

            animate border-color { duration: Theme.fast; }

            TouchArea {
                clicked => { input.focus(); }
            }

            inner := Rectangle {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                clip: true;

                Text {
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                    text: root.text == "" && input.preedit-text == "" ? root.placeholder : "";
                    font-size: Theme.text-body;
                    color: Theme.text-faint;
                    overflow: elide;
                    accessible-role: none;
                }

                input := TextInput {
                    property <length> computed-x;
                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: 100%;
                    vertical-alignment: center;
                    single-line: true;
                    input-type: root.input-type;
                    font-size: Theme.text-body;
                    color: Theme.text;
                    selection-background-color: Theme.accent-soft;
                    selection-foreground-color: Theme.text;
                    accessible-label: root.label != "" ? root.label : root.placeholder;

                    cursor-position-changed(pos) => {
                        if pos.x + self.computed-x < 0px {
                            self.computed-x = -pos.x;
                        } else if pos.x + self.computed-x > parent.width - self.text-cursor-width {
                            self.computed-x = parent.width - pos.x - self.text-cursor-width;
                        }
                    }
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(self.text); }
                }
            }
        }

        if root.hint != "" : Text {
            text: root.hint;
            font-size: Theme.text-caption;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }
}

// Read-only field that opens a picker sheet.
export component SelectField {
    in property <string> label;
    in property <string> value;
    in property <string> placeholder: "Choose";
    callback clicked();

    VerticalLayout {
        spacing: 6px;

        if root.label != "" : FieldLabel { text: root.label; }

        Rectangle {
            height: Theme.field-height;
            border-radius: Theme.radius-md;
            background: touch.pressed ? Theme.surface-pressed : Theme.surface-sunken;
            border-width: 1px;
            border-color: Theme.border;
            accessible-role: combobox;
            accessible-label: root.label;
            accessible-value: root.value;
            accessible-action-default => { root.clicked(); }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 8px;

                Text {
                    text: root.value != "" ? root.value : root.placeholder;
                    color: root.value != "" ? Theme.text : Theme.text-faint;
                    font-size: Theme.text-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Icon {
                    path: Icons.chevron-down;
                    color: Theme.text-muted;
                    size: 20px;
                }
            }

            touch := TouchArea {
                clicked => { root.clicked(); }
            }
        }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled();

    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: checked ? Theme.accent : Theme.border;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }

    animate background { duration: Theme.medium; }

    knob := Rectangle {
        width: 26px;
        height: 26px;
        y: 3px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        border-radius: 13px;
        background: #FFFFFF;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000033;

        animate x { duration: Theme.medium; easing: ease-out; }
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

// Equal-width segmented control with a sliding selection.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <string> label;
    callback select(int);

    property <length> item-width: (self.width - 8px) / max(1, options.length);

    height: 40px;
    border-radius: Theme.radius-md;
    background: Theme.surface-sunken;
    accessible-role: tab-list;
    accessible-label: root.label;

    Rectangle {
        x: 4px + root.selected * root.item-width;
        y: 4px;
        width: root.item-width;
        height: parent.height - 8px;
        border-radius: Theme.radius-sm + 1px;
        background: Theme.surface;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.dark ? #00000066 : #0000001f;

        animate x { duration: Theme.medium; easing: ease-out; }
    }

    for option[i] in root.options : Rectangle {
        x: 4px + i * root.item-width;
        y: 4px;
        width: root.item-width;
        height: parent.height - 8px;
        accessible-role: tab;
        accessible-label: option;
        accessible-item-selected: i == root.selected;
        accessible-action-default => { root.select(i); }

        Text {
            text: option;
            font-size: Theme.text-sub;
            font-weight: i == root.selected ? Theme.weight-semibold : Theme.weight-medium;
            color: i == root.selected ? Theme.text : Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            width: parent.width - 8px;
        }

        TouchArea {
            clicked => { root.select(i); }
        }
    }
}

// ---------------------------------------------------------------------------
// Data display
// ---------------------------------------------------------------------------

export component StatusPill inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;

    height: 24px;
    border-radius: 12px;
    background: Theme.tone-bg(root.tone);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: Theme.text-caption;
            font-weight: Theme.weight-semibold;
            color: Theme.tone-fg(root.tone);
            vertical-alignment: center;
        }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <Tone> tone: Tone.accent;

    height: 6px;
    border-radius: 3px;
    background: Theme.surface-sunken;
    accessible-role: progress-indicator;
    accessible-value: round(max(0, min(1, root.value)) * 100) + "%";

    Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.value));
        height: parent.height;
        border-radius: parent.border-radius;
        background: Theme.tone-fg(root.tone);

        animate width { duration: Theme.medium; easing: ease-out; }
    }
}

export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <bool> muted: false;
    in property <length> size: 40px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: muted ? Theme.surface-sunken : Theme.accent-soft;
    accessible-role: none;

    Text {
        text: root.initials;
        font-size: root.size * 0.38;
        font-weight: Theme.weight-semibold;
        color: root.muted ? Theme.text-muted : Theme.on-accent-soft;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Label above value, used in summary rows.
export component Metric {
    in property <string> label;
    in property <string> value;
    in property <Tone> tone: Tone.neutral;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: root.label;
            font-size: Theme.text-caption;
            font-weight: Theme.weight-medium;
            color: Theme.text-muted;
            overflow: elide;
        }
        Text {
            text: root.value;
            font-size: Theme.text-headline;
            font-weight: Theme.weight-semibold;
            color: root.tone == Tone.neutral ? Theme.text : Theme.tone-fg(root.tone);
            overflow: elide;
        }
    }
}

export component SectionHeader {
    in property <string> title;
    in property <string> caption;
    in property <string> action-text;
    in property <string> action-icon;
    callback action();

    min-height: 40px;

    HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.title;
                font-size: Theme.text-headline + 1px;
                font-weight: Theme.weight-bold;
                color: Theme.text;
                overflow: elide;
                accessible-role: AccessibleRole.text;
            }
            if root.caption != "" : Text {
                text: root.caption;
                font-size: Theme.text-caption;
                color: Theme.text-muted;
                overflow: elide;
            }
        }

        if root.action-text != "" : AppButton {
            text: root.action-text;
            icon: root.action-icon;
            kind: ButtonKind.ghost;
            compact: true;
            clicked => { root.action(); }
        }
    }
}

export component EmptyState {
    in property <string> icon: Icons.receipt;
    in property <string> title;
    in property <string> body;
    in property <string> action-text;
    callback action();

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-2;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 26px;
                background: Theme.surface-sunken;
                Icon {
                    path: root.icon;
                    color: Theme.text-muted;
                    size: 24px;
                }
            }
        }
        Rectangle { height: 4px; }
        Text {
            text: root.title;
            font-size: Theme.text-headline;
            font-weight: Theme.weight-semibold;
            color: Theme.text;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.body != "" : Text {
            text: root.body;
            font-size: Theme.text-sub;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.action-text != "" : HorizontalLayout {
            alignment: center;
            padding-top: Theme.space-2;
            AppButton {
                text: root.action-text;
                kind: ButtonKind.secondary;
                compact: true;
                clicked => { root.action(); }
            }
        }
    }
}

// Inline status message. Errors stay until dismissed; successes are short.
export component Banner inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    callback dismiss();

    background: error ? Theme.danger-soft : Theme.success-soft;
    border-radius: Theme.radius-md;
    accessible-role: AccessibleRole.text;
    accessible-label: (error ? "Error: " : "") + root.text;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 10px;

        Icon {
            path: root.error ? Icons.alert : Icons.check;
            color: root.error ? Theme.danger : Theme.success;
            size: 20px;
        }
        Text {
            text: root.text;
            horizontal-stretch: 1;
            vertical-alignment: center;
            wrap: word-wrap;
            font-size: Theme.text-sub;
            font-weight: Theme.weight-medium;
            color: root.error ? Theme.danger : Theme.success;
        }
        IconButton {
            icon: Icons.close;
            label: "Dismiss message";
            icon-size: 18px;
            tint: root.error ? Theme.danger : Theme.success;
            clicked => { root.dismiss(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Bottom sheet
// ---------------------------------------------------------------------------

// Full-window overlay with a scrim and a panel that slides up from the bottom.
// Place it as a direct child of the window so it covers everything.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> error;
    in property <length> bottom-inset;
    callback dismiss();
    callback clear-error();

    property <bool> shown: false;
    init => { self.shown = true; }

    background: shown ? Theme.scrim : transparent;
    animate background { duration: Theme.medium; }

    TouchArea {
        clicked => { root.dismiss(); }
    }

    panel := Rectangle {
        width: min(parent.width, 560px);
        x: (parent.width - self.width) / 2;
        height: min(content.preferred-height, parent.height - 48px);
        y: root.shown ? parent.height - self.height : parent.height;
        background: Theme.surface;
        border-top-left-radius: Theme.radius-xl;
        border-top-right-radius: Theme.radius-xl;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        accessible-role: groupbox;
        accessible-label: root.title;

        animate y { duration: Theme.medium; easing: ease-out; }

        // Swallow taps so they don't reach the scrim.
        TouchArea { }

        content := VerticalLayout {
            padding-left: Theme.space-5;
            padding-right: Theme.space-5;
            padding-top: 10px;
            padding-bottom: Theme.space-5 + root.bottom-inset;
            spacing: Theme.space-4;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.border;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.title;
                        font-size: Theme.text-title;
                        font-weight: Theme.weight-bold;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    if root.subtitle != "" : Text {
                        text: root.subtitle;
                        font-size: Theme.text-sub;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
                IconButton {
                    icon: Icons.close;
                    label: "Close";
                    filled: true;
                    icon-size: 18px;
                    clicked => { root.dismiss(); }
                }
            }

            if root.error != "" : Banner {
                text: root.error;
                error: true;
                dismiss => { root.clear-error(); }
            }

            @children
        }
    }
}

// A tappable row inside a sheet (pickers and action lists).
export component SheetOption inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> selected;
    in property <Tone> tone: Tone.neutral;
    callback clicked();

    property <color> fg: tone == Tone.danger ? Theme.danger : Theme.text;

    height: 52px;
    border-radius: Theme.radius-md;
    background: touch.pressed ? Theme.surface-pressed : (selected ? Theme.accent-soft : transparent);
    accessible-role: button;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    animate background { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        if root.icon != "" : Icon {
            path: root.icon;
            color: root.fg;
            size: 22px;
        }
        Text {
            text: root.text;
            horizontal-stretch: 1;
            vertical-alignment: center;
            font-size: Theme.text-body;
            font-weight: root.selected ? Theme.weight-semibold : Theme.weight-medium;
            color: root.selected ? Theme.on-accent-soft : root.fg;
            overflow: elide;
        }
        if root.selected : Icon {
            path: Icons.check;
            color: Theme.on-accent-soft;
            size: 20px;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
