// Shared building blocks. Everything here reads from `Theme` so screens never
// hard-code colours, radii, or font sizes.

import { ScrollView } from "std-widgets.slint";
import { Theme, Tone } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { CalendarDay } from "models.slint";

export { Theme, Tone, Icon, Icons }

export enum ButtonKind { primary, secondary, ghost, danger, danger-soft }

// ---------------------------------------------------------------------------
// Surfaces
// ---------------------------------------------------------------------------

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;

    // A layout makes every child fill the card's width, so wrapped text
    // inside components (e.g. EmptyState) wraps instead of overflowing.
    VerticalLayout {
        @children
    }
}

// A card that is itself the tap target (whole-row navigation).
export component TapCard inherits Rectangle {
    in property <string> label;
    callback clicked();

    background: touch.pressed ? Theme.surface-pressed : Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    animate background { duration: Theme.fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    @children
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

// ---------------------------------------------------------------------------
// Buttons
// ---------------------------------------------------------------------------

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <ButtonKind> kind: ButtonKind.primary;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback clicked();

    property <color> fg: kind == ButtonKind.primary ? Theme.on-accent
        : kind == ButtonKind.danger ? #FFFFFF
        : kind == ButtonKind.danger-soft ? Theme.danger
        : kind == ButtonKind.ghost ? Theme.accent
        : Theme.text;
    property <color> base: kind == ButtonKind.primary ? Theme.accent
        : kind == ButtonKind.danger ? Theme.danger
        : kind == ButtonKind.danger-soft ? Theme.danger-soft
        : kind == ButtonKind.ghost ? transparent
        : Theme.surface-sunken;
    property <color> pressed-bg: kind == ButtonKind.primary ? Theme.accent-pressed
        : kind == ButtonKind.danger ? Theme.danger.darker(0.15)
        : kind == ButtonKind.danger-soft ? Theme.danger-soft.darker(0.06)
        : Theme.surface-pressed;

    height: compact ? 40px : 48px;
    min-width: compact ? 40px : 64px;
    // Hug the label in rows; callers opt into full width explicitly.
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    background: touch.pressed && enabled ? pressed-bg : base;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    animate background { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: root.compact ? 12px : 18px;
        padding-right: root.compact ? 12px : 18px;
        spacing: 8px;
        alignment: center;

        if root.icon != "" : Icon {
            path: root.icon;
            color: root.fg;
            size: root.compact ? 18px : 20px;
        }
        if root.text != "" : Text {
            text: root.text;
            color: root.fg;
            font-size: root.compact ? Theme.text-sub : Theme.text-body;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <brush> tint: Theme.text;
    in property <bool> filled: false;
    in property <bool> enabled: true;
    in property <length> icon-size: 22px;
    callback clicked();

    width: Theme.touch;
    height: Theme.touch;
    border-radius: self.height / 2;
    background: touch.pressed && root.enabled ? Theme.surface-pressed
        : (root.filled ? Theme.surface-sunken : transparent);
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    animate background { duration: Theme.fast; }

    Icon {
        path: root.icon;
        color: root.tint;
        size: root.icon-size;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// Form controls
// ---------------------------------------------------------------------------

export component FieldLabel inherits Text {
    font-size: Theme.text-sub;
    font-weight: Theme.weight-semibold;
    color: Theme.text-muted;
}

// Single-line text field with a visible label. Built on TextInput so it looks
// the same under every Slint widget style (Fluent on desktop, Material on
// Android).
export component TextField {
    in property <string> label;
    in property <string> placeholder;
    in property <string> hint;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);

    forward-focus: input;

    VerticalLayout {
        opacity: root.enabled ? 1 : 0.45;
        spacing: 6px;

        if root.label != "" : FieldLabel { text: root.label; }

        box := Rectangle {
            height: Theme.field-height;
            border-radius: Theme.radius-md;
            background: Theme.surface-sunken;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;

            animate border-color { duration: Theme.fast; }

            TouchArea {
                enabled: root.enabled;
                clicked => { input.focus(); }
            }

            inner := Rectangle {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                clip: true;

                Text {
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                    text: root.text == "" && input.preedit-text == "" ? root.placeholder : "";
                    font-size: Theme.text-body;
                    color: Theme.text-faint;
                    overflow: elide;
                    accessible-role: none;
                }

                input := TextInput {
                    property <length> computed-x;
                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: 100%;
                    vertical-alignment: center;
                    single-line: true;
                    enabled: root.enabled;
                    read-only: !root.enabled;
                    input-type: root.input-type;
                    font-size: Theme.text-body;
                    color: Theme.text;
                    selection-background-color: Theme.accent-soft;
                    selection-foreground-color: Theme.text;
                    accessible-enabled: root.enabled;
                    accessible-label: root.label != "" ? root.label : root.placeholder;

                    cursor-position-changed(pos) => {
                        if pos.x + self.computed-x < 0px {
                            self.computed-x = -pos.x;
                        } else if pos.x + self.computed-x > parent.width - self.text-cursor-width {
                            self.computed-x = parent.width - pos.x - self.text-cursor-width;
                        }
                    }
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(self.text); }
                }
            }
        }

        if root.hint != "" : Text {
            text: root.hint;
            font-size: Theme.text-caption;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }
}

// Read-only field that opens a picker sheet.
export component SelectField {
    in property <string> label;
    in property <string> value;
    in property <string> placeholder: "Choose";
    callback clicked();

    VerticalLayout {
        spacing: 6px;

        if root.label != "" : FieldLabel { text: root.label; }

        Rectangle {
            height: Theme.field-height;
            border-radius: Theme.radius-md;
            background: touch.pressed ? Theme.surface-pressed : Theme.surface-sunken;
            border-width: 1px;
            border-color: Theme.border;
            accessible-role: combobox;
            accessible-label: root.label;
            accessible-value: root.value;
            accessible-action-default => { root.clicked(); }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 8px;

                Text {
                    text: root.value != "" ? root.value : root.placeholder;
                    color: root.value != "" ? Theme.text : Theme.text-faint;
                    font-size: Theme.text-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Icon {
                    path: Icons.chevron-down;
                    color: Theme.text-muted;
                    size: 20px;
                }
            }

            touch := TouchArea {
                clicked => { root.clicked(); }
            }
        }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled();

    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: checked ? Theme.accent : Theme.border;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }

    animate background { duration: Theme.medium; }

    knob := Rectangle {
        width: 26px;
        height: 26px;
        y: 3px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        border-radius: 13px;
        background: #FFFFFF;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000033;

        animate x { duration: Theme.medium; easing: ease-out; }
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

// Equal-width segmented control with a sliding selection.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <string> label;
    callback select(int);

    property <length> item-width: (self.width - 8px) / max(1, options.length);

    height: 40px;
    border-radius: Theme.radius-md;
    background: Theme.surface-sunken;
    accessible-role: tab-list;
    accessible-label: root.label;

    Rectangle {
        x: 4px + root.selected * root.item-width;
        y: 4px;
        width: root.item-width;
        height: parent.height - 8px;
        border-radius: Theme.radius-sm + 1px;
        background: Theme.surface;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.dark ? #00000066 : #0000001f;

        animate x { duration: Theme.medium; easing: ease-out; }
    }

    for option[i] in root.options : Rectangle {
        x: 4px + i * root.item-width;
        y: 4px;
        width: root.item-width;
        height: parent.height - 8px;
        accessible-role: tab;
        accessible-label: option;
        accessible-item-selected: i == root.selected;
        accessible-action-default => { root.select(i); }

        Text {
            text: option;
            font-size: Theme.text-sub;
            font-weight: i == root.selected ? Theme.weight-semibold : Theme.weight-medium;
            color: i == root.selected ? Theme.text : Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            width: parent.width - 8px;
        }

        TouchArea {
            clicked => { root.select(i); }
        }
    }
}

// ---------------------------------------------------------------------------
// Data display
// ---------------------------------------------------------------------------

export component StatusPill inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;

    height: 24px;
    border-radius: 12px;
    background: Theme.tone-bg(root.tone);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: Theme.text-caption;
            font-weight: Theme.weight-semibold;
            color: Theme.tone-fg(root.tone);
            vertical-alignment: center;
        }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <Tone> tone: Tone.accent;

    height: 6px;
    border-radius: 3px;
    background: Theme.surface-sunken;
    accessible-role: progress-indicator;
    accessible-value: round(max(0, min(1, root.value)) * 100) + "%";

    Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.value));
        height: parent.height;
        border-radius: parent.border-radius;
        background: Theme.tone-fg(root.tone);

        animate width { duration: Theme.medium; easing: ease-out; }
    }
}

export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <bool> muted: false;
    in property <length> size: 40px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: muted ? Theme.surface-sunken : Theme.accent-soft;
    accessible-role: none;

    Text {
        text: root.initials;
        font-size: root.size * 0.38;
        font-weight: Theme.weight-semibold;
        color: root.muted ? Theme.text-muted : Theme.on-accent-soft;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Label above value, used in summary rows.
export component Metric {
    in property <string> label;
    in property <string> value;
    in property <Tone> tone: Tone.neutral;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: root.label;
            font-size: Theme.text-caption;
            font-weight: Theme.weight-medium;
            color: Theme.text-muted;
            overflow: elide;
        }
        Text {
            text: root.value;
            font-size: Theme.text-headline;
            font-weight: Theme.weight-semibold;
            color: root.tone == Tone.neutral ? Theme.text : Theme.tone-fg(root.tone);
            overflow: elide;
        }
    }
}

export component SectionHeader {
    in property <string> title;
    in property <string> caption;
    in property <string> action-text;
    in property <string> action-icon;
    callback action();

    min-height: 40px;

    HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.title;
                font-size: Theme.text-headline + 1px;
                font-weight: Theme.weight-bold;
                color: Theme.text;
                overflow: elide;
                accessible-role: AccessibleRole.text;
            }
            if root.caption != "" : Text {
                text: root.caption;
                font-size: Theme.text-caption;
                color: Theme.text-muted;
                overflow: elide;
            }
        }

        if root.action-text != "" : AppButton {
            text: root.action-text;
            icon: root.action-icon;
            kind: ButtonKind.ghost;
            compact: true;
            clicked => { root.action(); }
        }
    }
}

export component EmptyState {
    in property <string> icon: Icons.receipt;
    in property <string> title;
    in property <string> body;
    in property <string> action-text;
    callback action();

    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-2;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 26px;
                background: Theme.surface-sunken;
                Icon {
                    path: root.icon;
                    color: Theme.text-muted;
                    size: 24px;
                }
            }
        }
        Rectangle { height: 4px; }
        Text {
            text: root.title;
            font-size: Theme.text-headline;
            font-weight: Theme.weight-semibold;
            color: Theme.text;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.body != "" : Text {
            text: root.body;
            font-size: Theme.text-sub;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.action-text != "" : HorizontalLayout {
            alignment: center;
            padding-top: Theme.space-2;
            AppButton {
                text: root.action-text;
                kind: ButtonKind.secondary;
                compact: true;
                clicked => { root.action(); }
            }
        }
    }
}

// Inline status message. Errors stay until dismissed; successes are short.
export component Banner inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    in property <bool> warning: false;
    in property <bool> dismissible: true;
    callback dismiss();

    property <color> tone-color: error ? Theme.danger
        : warning ? Theme.warning
        : Theme.success;

    background: error ? Theme.danger-soft
        : warning ? Theme.warning-soft
        : Theme.success-soft;
    border-radius: Theme.radius-md;
    accessible-role: AccessibleRole.text;
    accessible-label: (error ? "Error: " : "") + root.text;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 10px;

        Icon {
            path: root.error || root.warning ? Icons.alert : Icons.check;
            color: root.tone-color;
            size: 20px;
        }
        Text {
            text: root.text;
            horizontal-stretch: 1;
            vertical-alignment: center;
            wrap: word-wrap;
            font-size: Theme.text-sub;
            font-weight: Theme.weight-medium;
            color: root.tone-color;
        }
        if root.dismissible : IconButton {
            icon: Icons.close;
            label: "Dismiss message";
            icon-size: 18px;
            tint: root.tone-color;
            clicked => { root.dismiss(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Bottom sheet
// ---------------------------------------------------------------------------

// Full-window overlay with a scrim and a panel that slides up from the bottom.
// Place it as a direct child of the window so it covers everything.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> error;
    in property <length> bottom-inset;
    callback dismiss();
    callback clear-error();

    property <bool> shown: false;
    init => { self.shown = true; }

    background: shown ? Theme.scrim : transparent;
    animate background { duration: Theme.medium; }

    TouchArea {
        clicked => { root.dismiss(); }
    }

    panel := Rectangle {
        width: min(parent.width, 560px);
        x: (parent.width - self.width) / 2;
        height: min(content.preferred-height, parent.height - 48px);
        y: root.shown ? parent.height - self.height : parent.height;
        background: Theme.surface;
        border-top-left-radius: Theme.radius-xl;
        border-top-right-radius: Theme.radius-xl;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        accessible-role: groupbox;
        accessible-label: root.title;

        animate y { duration: Theme.medium; easing: ease-out; }

        // Swallow taps so they don't reach the scrim.
        TouchArea { }

        content := VerticalLayout {
            padding-left: Theme.space-5;
            padding-right: Theme.space-5;
            padding-top: 10px;
            padding-bottom: Theme.space-5 + root.bottom-inset;
            spacing: Theme.space-4;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.border;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.title;
                        font-size: Theme.text-title;
                        font-weight: Theme.weight-bold;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    if root.subtitle != "" : Text {
                        text: root.subtitle;
                        font-size: Theme.text-sub;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
                IconButton {
                    icon: Icons.close;
                    label: "Close";
                    filled: true;
                    icon-size: 18px;
                    clicked => { root.dismiss(); }
                }
            }

            if root.error != "" : Banner {
                text: root.error;
                error: true;
                dismiss => { root.clear-error(); }
            }

            @children
        }
    }
}

// A tappable row inside a sheet (pickers and action lists).
export component SheetOption inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> selected;
    in property <Tone> tone: Tone.neutral;
    callback clicked();

    property <color> fg: tone == Tone.danger ? Theme.danger : Theme.text;

    height: 52px;
    border-radius: Theme.radius-md;
    background: touch.pressed ? Theme.surface-pressed : (selected ? Theme.accent-soft : transparent);
    accessible-role: button;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    animate background { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        if root.icon != "" : Icon {
            path: root.icon;
            color: root.fg;
            size: 22px;
        }
        Text {
            text: root.text;
            horizontal-stretch: 1;
            vertical-alignment: center;
            font-size: Theme.text-body;
            font-weight: root.selected ? Theme.weight-semibold : Theme.weight-medium;
            color: root.selected ? Theme.on-accent-soft : root.fg;
            overflow: elide;
        }
        if root.selected : Icon {
            path: Icons.check;
            color: Theme.on-accent-soft;
            size: 20px;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Label / value row used by the read-only payment detail sheet.
export component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> tappable: false;
    callback clicked();

    height: 44px;
    background: row-touch.pressed && root.tappable ? Theme.surface-pressed : transparent;
    accessible-role: button;
    accessible-label: root.label + ": " + root.value;
    accessible-action-default => { if root.tappable { root.clicked(); } }

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;

        Text {
            text: root.label;
            horizontal-stretch: 1;
            vertical-alignment: center;
            font-size: Theme.text-sub;
            color: Theme.text-muted;
            overflow: elide;
        }
        Text {
            text: root.value;
            vertical-alignment: center;
            font-size: Theme.text-body;
            font-weight: Theme.weight-semibold;
            color: Theme.text;
            overflow: elide;
        }
        if root.tappable : Icon {
            path: Icons.chevron-right;
            color: Theme.text-faint;
            size: 16px;
        }
    }

    row-touch := TouchArea {
        enabled: root.tappable;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// Calendar picker
// ---------------------------------------------------------------------------

export component CalendarCell inherits Rectangle {
    in property <int> day;
    in property <bool> in-month: true;
    in property <bool> selected: false;
    in property <bool> today: false;
    in property <bool> enabled: true;
    callback picked();

    height: 44px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent
        : (touch.pressed && root.enabled ? Theme.surface-pressed : transparent);
    border-width: root.today && !root.selected ? 1px : 0px;
    border-color: Theme.accent;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: "" + root.day + (root.selected ? ", selected" : "") + (root.today ? ", today" : "");

    Text {
        text: "" + root.day;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.text-body;
        font-weight: root.selected ? Theme.weight-semibold : Theme.weight-regular;
        color: root.selected ? Theme.on-accent
            : root.today ? Theme.accent
            : root.in-month ? Theme.text
            : Theme.text-faint;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.picked(); }
    }
}

component PickerChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <length> cell-height: 44px;
    callback picked();

    height: root.cell-height;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent
        : (touch.pressed && root.enabled ? Theme.surface-pressed : Theme.surface-sunken);
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.text;

    Text {
        text: root.text;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.text-sub;
        font-weight: root.selected ? Theme.weight-semibold : Theme.weight-medium;
        color: root.selected ? Theme.on-accent : Theme.text;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.picked(); }
    }
}

// Month-grid calendar inside the standard bottom sheet. The day model is
// built in Rust so month math (weekday offsets, month edges) stays tested.
export component CalendarSheet {
    in property <string> title;
    in property <length> bottom-inset;
    in property <[CalendarDay]> days;
    in property <[string]> month-names;
    in property <int> year;
    in property <int> month;
    in property <string> header-label;
    in property <bool> month-only: false;
    in property <bool> allow-clear: false;
    in property <bool> include-time: false;
    in property <int> hour: 12;
    in property <int> minute: 0;
    in property <bool> pm: false;
    in property <string> time-label;

    callback dismiss();
    callback prev-month();
    callback next-month();
    callback pick(string);
    callback today();
    callback clear();
    callback confirm();
    callback time-changed(int, int, bool);
    callback pick-month(int);
    callback pick-year(int);

    in-out property <bool> zoom: false;
    in-out property <bool> time-open: false;
    in-out property <int> year-page-start: 2000 + ((root.year - 2000) / 12) * 12;

    // Keep the year strip on the page of the shown year (month-only mode
    // steps years with the header chevrons).
    changed year => {
        if root.month-only {
            self.year-page-start = 2000 + ((root.year - 2000) / 12) * 12;
        }
    }

    Sheet {
        title: root.title;
        bottom-inset: root.bottom-inset;
        dismiss => { root.dismiss(); }

        HorizontalLayout {
            spacing: Theme.space-1;

            IconButton {
                icon: Icons.chevron-left;
                label: root.month-only ? "Previous year" : "Previous month";
                enabled: root.month-only
                    ? root.year > 2000
                    : !(root.year == 2000 && root.month == 1);
                clicked => { root.prev-month(); }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: Theme.touch;
                border-radius: Theme.radius-md;
                background: header-touch.pressed && !root.month-only ? Theme.surface-pressed : transparent;
                accessible-role: button;
                accessible-label: root.header-label + (root.month-only ? "" : ", change month and year");

                Text {
                    text: root.header-label;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.text-headline;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text;
                }

                header-touch := TouchArea {
                    enabled: !root.month-only;
                    clicked => {
                        root.zoom = !root.zoom;
                        if root.zoom {
                            root.year-page-start = 2000 + ((root.year - 2000) / 12) * 12;
                        }
                    }
                }
            }

            IconButton {
                icon: Icons.chevron-right;
                label: root.month-only ? "Next year" : "Next month";
                enabled: root.month-only
                    ? root.year < 2100
                    : !(root.year == 2100 && root.month == 12);
                clicked => { root.next-month(); }
            }
        }

        if !root.month-only && !root.zoom : VerticalLayout {
            spacing: 0px;

            HorizontalLayout {
                for name in ["S", "M", "T", "W", "T", "F", "S"] : Text {
                    horizontal-stretch: 1;
                    height: 28px;
                    text: name;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.text-caption;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-muted;
                }
            }

            if root.days.length >= 42 : VerticalLayout {
                spacing: 0px;
                for row in 6 : HorizontalLayout {
                    spacing: 0px;
                    for col in 7 : CalendarCell {
                        horizontal-stretch: 1;
                        day: root.days[row * 7 + col].day;
                        in-month: root.days[row * 7 + col].in-month;
                        selected: root.days[row * 7 + col].selected;
                        today: root.days[row * 7 + col].today;
                        enabled: root.days[row * 7 + col].enabled;
                        picked => { root.pick(root.days[row * 7 + col].iso); }
                    }
                }
            }
        }

        if root.month-only || root.zoom : ScrollView {
            height: 320px;
            VerticalLayout {
                spacing: Theme.space-2;

                HorizontalLayout {
                    spacing: Theme.space-1;
                    IconButton {
                        icon: Icons.chevron-left;
                        label: "Previous years";
                        enabled: root.year-page-start > 2000;
                        clicked => { root.year-page-start = max(2000, root.year-page-start - 12); }
                    }
                    Text {
                        text: "" + root.year-page-start + "–" + (root.year-page-start + 11);
                        horizontal-stretch: 1;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: Theme.text-sub;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text-muted;
                    }
                    IconButton {
                        icon: Icons.chevron-right;
                        label: "Next years";
                        enabled: root.year-page-start < 2100;
                        clicked => { root.year-page-start = min(2100, root.year-page-start + 12); }
                    }
                }

                for row in 3 : HorizontalLayout {
                    spacing: Theme.space-1;
                    for col in 4 : PickerChip {
                        horizontal-stretch: 1;
                        cell-height: 34px;
                        text: "" + (root.year-page-start + row * 4 + col);
                        selected: (root.year-page-start + row * 4 + col) == root.year;
                        enabled: (root.year-page-start + row * 4 + col) <= 2100;
                        picked => { root.pick-year(root.year-page-start + row * 4 + col); }
                    }
                }

                for row in 4 : HorizontalLayout {
                    spacing: Theme.space-1;
                    for col in 3 : PickerChip {
                        horizontal-stretch: 1;
                        property <int> month-index: row * 3 + col;
                        text: root.month-names.length > self.month-index ? root.month-names[self.month-index] : "";
                        selected: self.month-index + 1 == root.month;
                        picked => {
                            root.pick-month(self.month-index + 1);
                            root.zoom = false;
                        }
                    }
                }
            }
        }

        if root.include-time : VerticalLayout {
            spacing: Theme.space-2;

            Rectangle {
                height: Theme.field-height;
                border-radius: Theme.radius-md;
                background: time-touch.pressed ? Theme.surface-pressed : Theme.surface-sunken;
                accessible-role: button;
                accessible-label: "Payment time " + root.time-label;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: Theme.space-2;
                    Text {
                        text: "Time";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        font-size: Theme.text-body;
                        color: Theme.text;
                    }
                    Text {
                        text: root.time-label;
                        vertical-alignment: center;
                        font-size: Theme.text-body;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text;
                    }
                    Icon {
                        path: Icons.clock;
                        color: Theme.text-muted;
                        size: 20px;
                    }
                }

                time-touch := TouchArea {
                    clicked => { root.time-open = !root.time-open; }
                }
            }

            if root.time-open : VerticalLayout {
                spacing: Theme.space-2;

                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: "Hour";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        font-size: Theme.text-sub;
                        color: Theme.text-muted;
                    }
                    AppButton {
                        text: "−";
                        kind: ButtonKind.secondary;
                        compact: true;
                        clicked => { root.time-changed(root.hour == 1 ? 12 : root.hour - 1, root.minute, root.pm); }
                    }
                    Text {
                        text: "" + root.hour;
                        width: 32px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: Theme.text-body;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text;
                    }
                    AppButton {
                        text: "+";
                        kind: ButtonKind.secondary;
                        compact: true;
                        clicked => { root.time-changed(root.hour == 12 ? 1 : root.hour + 1, root.minute, root.pm); }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: "Minute";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        font-size: Theme.text-sub;
                        color: Theme.text-muted;
                    }
                    AppButton {
                        text: "−";
                        kind: ButtonKind.secondary;
                        compact: true;
                        clicked => {
                            root.time-changed(root.hour, root.minute == 0 ? 59 : root.minute - 1, root.pm);
                        }
                    }
                    Text {
                        text: root.minute < 10 ? "0" + root.minute : "" + root.minute;
                        width: 32px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: Theme.text-body;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text;
                    }
                    AppButton {
                        text: "+";
                        kind: ButtonKind.secondary;
                        compact: true;
                        clicked => {
                            root.time-changed(root.hour, root.minute == 59 ? 0 : root.minute + 1, root.pm);
                        }
                    }
                }

                Segmented {
                    options: ["AM", "PM"];
                    selected: root.pm ? 1 : 0;
                    label: "AM or PM";
                    select(i) => { root.time-changed(root.hour, root.minute, i == 1); }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-2;
            if root.allow-clear : AppButton {
                text: "Clear";
                kind: ButtonKind.secondary;
                compact: true;
                clicked => { root.clear(); }
            }
            Rectangle { horizontal-stretch: 1; }
            AppButton {
                text: "Today";
                kind: ButtonKind.secondary;
                compact: true;
                clicked => { root.today(); }
            }
            if !root.month-only : AppButton {
                text: "Done";
                compact: true;
                clicked => { root.confirm(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Overpayment notice
// ---------------------------------------------------------------------------

export component OverpaymentDialog inherits Rectangle {
    in property <string> subtitle;
    in property <string> amount;
    in property <string> change;
    in property <string> due;
    callback dismiss();
    callback return-change();

    property <bool> shown: false;
    init => { self.shown = true; }

    background: Theme.scrim.with-alpha(0.92);

    TouchArea {
        clicked => { root.dismiss(); }
    }

    card := Rectangle {
        width: min(parent.width - 48px, 360px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.shown ? 0px : 8px);
        background: Theme.surface;
        border-radius: Theme.radius-xl;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000059;
        opacity: root.shown ? 1 : 0;
        accessible-role: groupbox;
        accessible-label: "Overpayment Received!";

        animate y, opacity { duration: Theme.medium; easing: ease-out; }

        // Swallow taps so the card itself never dismisses.
        TouchArea { }

        content := VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-3;

            HorizontalLayout {
                spacing: Theme.space-2;
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.warning-soft;
                    Icon {
                        path: Icons.alert;
                        color: Theme.warning;
                        size: 22px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton {
                    icon: Icons.close;
                    label: "Dismiss";
                    icon-size: 18px;
                    clicked => { root.dismiss(); }
                }
            }

            Text {
                text: "Overpayment Received!";
                font-size: Theme.text-title-lg;
                font-weight: Theme.weight-bold;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text {
                text: root.subtitle;
                font-size: Theme.text-sub;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            Text {
                text: "The tenant paid " + root.amount + ", which is " + root.change + " more than the required bill of " + root.due + ".";
                font-size: Theme.text-body;
                color: Theme.text;
                wrap: word-wrap;
            }

            AppButton {
                horizontal-stretch: 1;
                text: "Return change now";
                icon: Icons.undo;
                clicked => { root.return-change(); }
            }
            AppButton {
                horizontal-stretch: 1;
                text: "Later";
                kind: ButtonKind.secondary;
                clicked => { root.dismiss(); }
            }
        }
    }
}
