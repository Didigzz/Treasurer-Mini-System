// Row models filled from Rust (apps/mobile/src/app/*.rs).
// Money values arrive pre-formatted; the boolean flags let the UI pick tone
// and wording without parsing currency strings.

export struct BillRow {
    title: string,
    subtitle: string,
    amount: string,
    paid: string,
    status: string,
    progress: float,
    review: bool,
}

export struct BalanceRow {
    name: string,
    initials: string,
    amount: string,
    change: string,
    has-due: bool,
    has-change: bool,
}

export struct BoarderRow {
    name: string,
    initials: string,
    amount: string,
    change: string,
    archived: bool,
    has-due: bool,
    has-change: bool,
}

export struct ShareRow {
    name: string,
    // Base split share, before any additional charge.
    due: string,
    paid: string,
    // Base share + additional charge.
    balance: string,
    // Plain decimal ("1250.00") used to prefill the payment amount.
    balance-input: string,
    change: string,
    // "Change to Return ₱155.00", "Change Returned ₱155.00" or empty.
    change-status: string,
    charge: string,
    // "Unpaid", "Partial", "Paid – Cash" or "Paid – Online" on the bill screen;
    // the ledger keeps the plain "Paid".
    status: string,
    has-balance: bool,
    has-change: bool,
    has-change-status: bool,
    has-charge: bool,
}

// One row of the live "Split preview" in the edit-share sheet.
export struct ShareSplitPreviewRow {
    name: string,
    // Final share + charge.
    amount: string,
    pinned: bool,
}

// One payment in the edit-share sheet's "Payments on this share" list.
export struct SharePaymentRow {
    // Date and time the payment was recorded.
    title: string,
    // "Cash" or "Online Payment".
    subtitle: string,
    amount: string,
    undone: bool,
    // False on archived bills, which list their payments read-only.
    undoable: bool,
}

export struct PaymentRow {
    title: string,
    subtitle: string,
    amount: string,
    // "Cash" or "Online Payment".
    payment-type: string,
    // "Paid – Cash", "Paid – Online" or "Undone".
    status: string,
    change: string,
    // "Change to Return ₱155.00", "Change Returned ₱155.00" or empty.
    change-status: string,
    can-return: bool,
    has-change: bool,
    voided: bool,
}

export struct HistoryRow {
    period: string,
    bills: string,
    expected: string,
    applied: string,
    outstanding: string,
    // Net money collected by method for that month's bills; together they add
    // up to `applied`.
    cash-collected: string,
    online-collected: string,
    progress: float,
    settled: bool,
}

export struct TypeRow {
    name: string,
    count: string,
    archived: bool,
}

export struct PickRow {
    name: string,
    selected: bool,
    amount: string,
}

// One cell of the calendar grid. Built in Rust from money::calendar_weeks.
export struct CalendarDay {
    day: int,
    in-month: bool,
    selected: bool,
    today: bool,
    enabled: bool,
    iso: string,
}

// A boarder row in the "Manage shares" sheet.
export struct ManageRow {
    name: string,
    amount: string,
}
