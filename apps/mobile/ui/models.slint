// Row models filled from Rust (apps/mobile/src/app/*.rs).
// Money values arrive pre-formatted; the boolean flags let the UI pick tone
// and wording without parsing currency strings.

export struct BillRow {
    title: string,
    subtitle: string,
    amount: string,
    paid: string,
    status: string,
    progress: float,
    review: bool,
}

export struct BalanceRow {
    name: string,
    initials: string,
    amount: string,
    change: string,
    has-due: bool,
    has-change: bool,
}

export struct BoarderRow {
    name: string,
    initials: string,
    amount: string,
    change: string,
    archived: bool,
    has-due: bool,
    has-change: bool,
}

export struct ShareRow {
    name: string,
    due: string,
    paid: string,
    balance: string,
    // Plain decimal ("1250.00") used to prefill the payment amount.
    balance-input: string,
    change: string,
    status: string,
    has-balance: bool,
    has-change: bool,
}

export struct PaymentRow {
    title: string,
    subtitle: string,
    amount: string,
    change: string,
    can-return: bool,
    has-change: bool,
    voided: bool,
}

export struct HistoryRow {
    period: string,
    bills: string,
    expected: string,
    applied: string,
    outstanding: string,
    progress: float,
    settled: bool,
}

export struct TypeRow {
    name: string,
    count: string,
    archived: bool,
}

export struct PickRow {
    name: string,
    selected: bool,
    amount: string,
}
